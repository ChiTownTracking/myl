---
import Layout from "../layouts/Layout.astro";
import SlimHero from "../components/SlimHero.astro";
import { contactForm, organization, socialLinks } from "../data/site.js";
import qaImage from "../assets/images/myl-qa-2026/myl-qa-2026-community.jpg";
---

<Layout
  title="Contact"
  description="Contact Muslim Youth League Canada by email, phone, social media or at its Mississauga community address."
  image={qaImage}
>
  <main id="main">
    <SlimHero
      titleId="contact-hero-title"
      eyebrow="Contact MYL Canada"
      title="Start with a clear message."
      intro="Questions about an event, volunteering, partnerships or programming? Reach the team through the channel that best matches what you need."
      facts={[
        { label: "Email", value: organization.email },
        { label: "Based in", value: "Mississauga, Ontario" },
      ]}
    />

    <section class="section contact-main" aria-labelledby="contact-form-title">
      <div class="shell contact-main__grid">
        <div class="contact-main__primary">
          <p class="eyebrow">Send a message</p>
          <h2 id="contact-form-title">Tell us what you need.</h2>
          <p class="lead">
            The team replies by email, usually within a few days. The more context you give,
            the more useful the first reply will be.
          </p>

          <form
            class="site-form"
            data-site-form
            data-endpoint={contactForm.endpoint}
            data-fallback-email={organization.email}
            data-subject="Website enquiry"
            novalidate
          >
            <div class="site-form__row">
              <p class="field">
                <label for="cf-name">Name</label>
                <input
                  id="cf-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  minlength="2"
                  data-error-message="Please enter your name."
                  required
                />
                <span class="field__error" id="cf-name-error" data-error-for="name" hidden></span>
              </p>
              <p class="field">
                <label for="cf-email">Email</label>
                <input
                  id="cf-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  data-error-message="Please enter a valid email address."
                  required
                />
                <span class="field__error" id="cf-email-error" data-error-for="email" hidden></span>
              </p>
            </div>

            <p class="field">
              <label for="cf-topic">What is this about?</label>
              <select id="cf-topic" name="topic">
                <option>General enquiry</option>
                <option>Volunteering</option>
                <option>An event or program</option>
                <option>Partnership</option>
                <option>Media request</option>
              </select>
            </p>

            <p class="field">
              <label for="cf-message">Message</label>
              <textarea
                id="cf-message"
                name="message"
                rows="6"
                minlength="10"
                aria-describedby="cf-message-hint"
                data-error-message="Please add a little more detail so the team can help."
                required></textarea>
              <span class="field__hint" id="cf-message-hint">
                Event question? Add the event name and date. Volunteering? Share your city and
                availability. Partnership or media? Include the purpose and your timing.
              </span>
              <span class="field__error" id="cf-message-error" data-error-for="message" hidden></span>
            </p>

            <p class="site-form__trap" aria-hidden="true">
              <label for="cf-company">Company</label>
              <input id="cf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </p>

            <div class="site-form__actions">
              <button class="button" type="submit">Send message</button>
              <span class="site-form__status" data-form-status role="status" aria-live="polite"></span>
            </div>
          </form>
        </div>

        <aside class="contact-aside" aria-label="Other ways to reach MYL Canada">
          <dl class="contact-aside__list">
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${organization.email}`}>{organization.email}</a></dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd><a href={`tel:${organization.phoneHref}`}>{organization.phone}</a></dd>
            </div>
            <div>
              <dt>Visit or mail</dt>
              <dd>
                {organization.address}
                <a class="contact-aside__map" href={organization.mapsUrl} target="_blank" rel="noreferrer">
                  Open in maps ↗
                </a>
              </dd>
            </div>
          </dl>

          <div class="contact-aside__social">
            <p class="contact-aside__label">Follow</p>
            <ul>
              {
                socialLinks.map((social) => (
                  <li>
                    <a href={social.href} target="_blank" rel="noreferrer">
                      <span>{social.label}</span>
                      <strong>{social.handle}</strong>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </section>

  </main>
</Layout>

<style>
  .contact-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .contact-main__primary h2 {
    max-width: 16ch;
    margin-top: 0.85rem;
  }

  .contact-main__primary .lead {
    max-width: 46ch;
    margin-top: 1rem;
  }

  .contact-main__primary .site-form {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .contact-aside {
    position: sticky;
    top: clamp(5.5rem, 10vw, 7rem);
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--cream);
  }

  .contact-aside__list {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .contact-aside__list dt {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-aside__list dd {
    margin: 0.3rem 0 0;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .contact-aside__list a {
    color: var(--green-deep);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--green-deep) 35%, transparent);
    text-underline-offset: 0.22em;
  }

  .contact-aside__list a:hover {
    text-decoration-color: currentColor;
  }

  .contact-aside__map {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.85rem;
  }

  .contact-aside__social {
    margin-top: 1.75rem;
    padding-top: 1.35rem;
    border-top: 1px solid var(--cream-deep);
  }

  .contact-aside__label {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .contact-aside__social ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-aside__social a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.4rem 0;
    color: var(--ink);
  }

  .contact-aside__social span {
    font-size: 0.95rem;
  }

  .contact-aside__social strong {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .contact-aside__social a:hover strong {
    color: var(--green-deep);
  }

  @media (max-width: 900px) {
    .contact-main__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .contact-aside {
      position: static;
    }
  }
</style>

<script>
  import "../scripts/site-form.ts";
</script>
