---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { organization, socialLinks } from "../data/site.js";
import qaImage from "../assets/images/myl-qa-2026/myl-qa-2026-community.jpg";
---

<Layout
  title="Contact"
  description="Contact Muslim Youth League Canada by email, phone, social media or at its Mississauga community address."
  image={qaImage}
>
  <main id="main">
    <PageHero
      eyebrow="Contact MYL Canada"
      title="Start with a clear message."
      intro="Questions about an event, volunteering, partnerships or programming? Reach the team through the channel that best matches what you need."
      image={qaImage}
      imageAlt="A MYL Canada community question-and-answer gathering"
      tone="green"
      meta={[
        { label: "Email", value: organization.email },
        { label: "Based in", value: "Mississauga, Ontario" },
      ]}
    />

    <section class="section contact-options">
      <div class="shell contact-options__grid">
        <article class="contact-card contact-card--primary">
          <p class="eyebrow eyebrow--light">General enquiries</p>
          <h2>Email the team.</h2>
          <p>
            Best for volunteering, collaborations, speaking enquiries and questions that need context.
          </p>
          <a class="button button--light" href={`mailto:${organization.email}`}>{organization.email}</a>
        </article>
        <article class="contact-card">
          <span class="contact-card__number">01</span>
          <h3>Phone</h3>
          <p>For a direct conversation with the MYL Canada team.</p>
          <a class="text-link" href={`tel:${organization.phoneHref}`}>{organization.phone}</a>
        </article>
        <article class="contact-card">
          <span class="contact-card__number">02</span>
          <h3>Visit / mail</h3>
          <p>{organization.address}</p>
          <a class="text-link" href={organization.mapsUrl} target="_blank" rel="noreferrer">Open in maps ↗</a>
        </article>
        <article class="contact-card">
          <span class="contact-card__number">03</span>
          <h3>Event updates</h3>
          <p>For current dates, eligibility and registration links, use the official social post.</p>
          <a class="text-link" href="https://www.instagram.com/mylcanada/" target="_blank" rel="noreferrer">Follow @mylcanada ↗</a>
        </article>
      </div>
    </section>

    <section class="section section--cream social-section">
      <div class="shell social-section__grid">
        <div>
          <p class="eyebrow">Stay connected</p>
          <h2>Follow the work where it happens.</h2>
          <p class="lead">
            Registrations, recaps, reminders and community moments are shared across MYL Canada’s official profiles.
          </p>
        </div>
        <ul>
          {
            socialLinks.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noreferrer">
                  <span>{social.label}</span><strong>{social.handle}</strong><i aria-hidden="true">↗</i>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="section contact-note">
      <div class="shell contact-note__grid">
        <div>
          <p class="eyebrow">Before you send</p>
          <h2>Help the team help you.</h2>
        </div>
        <ul>
          <li><strong>Event question?</strong><span>Include the event name and date.</span></li>
          <li><strong>Want to volunteer?</strong><span>Share your city, availability and area of interest.</span></li>
          <li><strong>Partnership idea?</strong><span>Describe the audience, purpose, timing and what you are proposing.</span></li>
          <li><strong>Media request?</strong><span>Include your publication, deadline and the person you hope to reach.</span></li>
        </ul>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact-options__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-card {
    display: flex;
    min-height: 340px;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }

  .contact-card--primary {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1rem 4rem;
    min-height: 360px;
    border-color: var(--green-deep);
    border-radius: var(--radius-lg);
    background: var(--green-deep);
    color: var(--white);
  }

  .contact-card--primary .eyebrow {
    grid-column: 1;
    align-self: end;
  }

  .contact-card--primary h2 {
    grid-column: 1;
    align-self: start;
  }

  .contact-card--primary > p:not(.eyebrow) {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: end;
    color: rgb(255 255 255 / 0.72);
    font-size: 1.08rem;
  }

  .contact-card--primary .button {
    grid-column: 2;
    justify-self: start;
    align-self: start;
  }

  .contact-card__number {
    color: var(--red);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .contact-card h3 {
    margin-top: 4rem;
  }

  .contact-card > p:not(.eyebrow) {
    margin-top: 0.8rem;
    color: var(--muted);
  }

  .contact-card .text-link {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .social-section__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .social-section h2 {
    margin-top: 1rem;
  }

  .social-section .lead {
    margin-top: 1.2rem;
  }

  .social-section ul {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--cream-deep);
  }

  .social-section li {
    border-bottom: 1px solid var(--cream-deep);
  }

  .social-section a {
    position: relative;
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.2rem;
  }

  .social-section a span {
    color: var(--red-deep);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .social-section a i {
    color: var(--red);
    font-style: normal;
    font-size: 1.2rem;
    transition: transform 180ms ease;
  }

  .social-section a:hover i {
    transform: translate(0.2rem, -0.2rem);
  }

  .contact-note__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .contact-note h2 {
    margin-top: 1rem;
  }

  .contact-note ul {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .contact-note li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .contact-note li span {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .contact-options__grid,
    .social-section__grid,
    .contact-note__grid,
    .contact-card--primary {
      grid-template-columns: 1fr;
    }

    .contact-card--primary > *,
    .contact-card--primary .eyebrow,
    .contact-card--primary h2,
    .contact-card--primary > p:not(.eyebrow),
    .contact-card--primary .button {
      grid-column: 1;
      grid-row: auto;
    }
  }

  @media (max-width: 560px) {
    .social-section a,
    .contact-note li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .social-section a i {
      position: absolute;
      right: var(--gutter);
    }
  }
</style>
