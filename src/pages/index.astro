---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import hoodieImage from "../assets/images/herosection/myl-back-hoodies.png";
import mercyImage from "../assets/images/al-rahma-conference/shaykh-hammad-facing-crowd.png";
import hoopsAction from "../assets/images/hoops4humanity/basketball-1.png";
import hoopsTeam from "../assets/images/hoops4humanity/myl-basketball.png";
import hidayahMainImage from "../assets/images/al-hidayah/al-hidayah-canada.jpg";
import hidayahAudience from "../assets/images/al-hidayah/al-hidayah-2023-gathering.jpg";
import hidayahWorkshop from "../assets/images/al-hidayah/al-hidayah-2026-workshop.jpg";
import mercy2021 from "../assets/images/mercy-conference/2021/mercy-2021-audience.jpg";
import mylCommunity from "../assets/images/myl-qa-2026/myl-qa-2026-community.jpg";
import renaissanceCover from "../assets/images/renaissance/summer-2025.png";

const eventHighlights = [
  {
    title: "Hoops 4 Humanity",
    label: "Sport & service",
    href: "/programs/hoops-for-humanity/",
    image: hoopsAction,
    alt: "A player taking a shot during Hoops 4 Humanity",
  },
  {
    title: "Youth conversations",
    label: "Community gathering",
    href: "/events/",
    image: mylCommunity,
    alt: "MYL Canada organizers and guests after a youth question-and-answer session",
  },
  {
    title: "Al-Hidayah workshops",
    label: "Learning together",
    href: "/events/al-hidayah/",
    image: hidayahWorkshop,
    alt: "Young people participating in an Al-Hidayah Canada workshop",
  },
  {
    title: "The first Al-Rahma",
    label: "Al-Rahma · 2021",
    href: "/events/mercy-for-humanity/",
    image: mercy2021,
    alt: "Audience at the first Al-Rahma conference in 2021",
  },
  {
    title: "Community on the court",
    label: "Hoops 4 Humanity",
    href: "/programs/hoops-for-humanity/",
    image: hoopsTeam,
    alt: "MYL Canada participants gathered on a basketball court",
  },
  {
    title: "A room built for learning",
    label: "Al-Hidayah Canada",
    href: "/events/al-hidayah/",
    image: hidayahAudience,
    alt: "A full audience gathered for an Al-Hidayah learning session",
  },
];
---

<Layout title="Muslim Youth League Canada" image={hoopsTeam}>
  <main id="main">
    <section class="hero">
      <Image
        class="hero__background"
        src={hoopsTeam}
        alt=""
        widths={[960, 1600, 2400, 3152]}
        sizes="100vw"
        format="webp"
        quality={84}
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__stage shell">
        <div class="hero__layout">
          <div class="hero__message">
            <p class="hero__eyebrow">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M8.2 11.2a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm7.6 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3 19.1v-1.3a4.3 4.3 0 0 1 4.3-4.3h1.8a4.3 4.3 0 0 1 4.3 4.3v1.3m-1.2-5.2a4.3 4.3 0 0 1 2.7-.9h1.8a4.3 4.3 0 0 1 4.3 4.3v1.8" />
              </svg>
              Youth empowered
            </p>
            <h1>Grow in faith.<br /><span>Lead with purpose.</span></h1>
            <span class="hero__rule" aria-hidden="true"></span>
            <p class="hero__lead">
              MYL Canada helps young Muslims deepen their faith, build lasting friendships and
              serve their communities with confidence.
            </p>
            <div class="button-row">
              <a class="button" href="/get-involved/">Join the community <span aria-hidden="true">→</span></a>
              <a class="button button--ghost" href="/programs/">Explore programs</a>
            </div>
          </div>

          <figure class="hero__visual">
            <span class="hero__visual-frame" aria-hidden="true"></span>
            <div class="hero__visual-card">
              <Image
                src={hoodieImage}
                alt="Two young people wearing Muslim Youth League Canada hoodies"
                widths={[520, 760, 1051]}
                sizes="(max-width: 900px) 50vw, 32vw"
                format="webp"
                quality={90}
                loading="eager"
              />
            </div>
            <figcaption>
              <span class="hero__visual-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22">
                  <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.7A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" />
                </svg>
              </span>
              <span><strong>Connect · Serve · Lead</strong><small>Building a brighter future together.</small></span>
            </figcaption>
          </figure>
        </div>

      </div>
    </section>

    <section class="section section--compact events-showcase" id="past-events">
      <div class="shell events-showcase__heading">
        <p class="eyebrow">Our event story</p>
        <h2>Gatherings that <span>stay with you.</span></h2>
        <p>
          From landmark conferences to residential learning, sport and youth conversations, MYL
          Canada creates spaces where faith becomes friendship, service and action.
        </p>
      </div>

      <div class="shell event-features">
        <article class="event-feature">
          <figure class="event-feature__media">
            <Image
              src={mercyImage}
              alt="Shaykh Hammad Mustafa addressing a full Al-Rahma conference audience"
              widths={[720, 1054]}
              sizes="(max-width: 860px) 92vw, 50vw"
              format="webp"
              quality={88}
            />
            <span class="event-feature__metric"><strong>3</strong> annual editions</span>
          </figure>
          <div class="event-feature__copy">
            <p class="event-feature__index">01 · Flagship conference</p>
            <h3>Al-Rahma <span>(Mercy for Humanity)</span></h3>
            <p>
              Across its 2021, 2022 and 2023 editions, this landmark conference brought Canadian
              youth and scholars together around the Prophetic model of mercy, dignity, peace and
              justice.
            </p>
            <ul class="event-feature__facts" aria-label="Al-Rahma conference highlights">
              <li><strong>2021–2023</strong><span>Confirmed editions</span></li>
              <li><strong>1,000+</strong><span>Attendees in 2022</span></li>
            </ul>
            <a class="button button--green" href="/events/mercy-for-humanity/">Explore Al-Rahma <span aria-hidden="true">→</span></a>
          </div>
        </article>

        <article class="event-feature event-feature--reverse">
          <figure class="event-feature__media">
            <Image
              src={hidayahMainImage}
              alt="A speaker addressing a full Al-Hidayah Canada auditorium"
              widths={[720, 1100, 1500]}
              sizes="(max-width: 860px) 92vw, 50vw"
              format="webp"
              quality={88}
            />
            <span class="event-feature__metric"><strong>500+</strong> participants</span>
          </figure>
          <div class="event-feature__copy">
            <p class="event-feature__index">02 · Residential retreat</p>
            <h3>Al-Hidayah <span>Canada</span></h3>
            <p>
              A residential MQI Canada retreat supported by MYL volunteers, bringing scholarship,
              worship, reflection and companionship together in one shared experience.
            </p>
            <ul class="event-feature__facts" aria-label="Al-Hidayah Canada highlights">
              <li><strong>3 days</strong><span>Residential program</span></li>
              <li><strong>500+</strong><span>Participants</span></li>
            </ul>
            <a class="button button--green" href="/events/al-hidayah/">Discover Al-Hidayah <span aria-hidden="true">→</span></a>
          </div>
        </article>
      </div>

      <div class="event-marquee">
        <div class="shell event-marquee__heading">
          <p class="eyebrow">More from the community</p>
          <a class="text-link" href="/events/">View all events</a>
        </div>
        <div class="event-marquee__viewport" aria-label="More MYL Canada event highlights" tabindex="0">
          <div class="event-marquee__track">
            {
              [false, true].map((isDuplicate) => (
                <div class="event-marquee__group" aria-hidden={isDuplicate ? "true" : undefined}>
                  {eventHighlights.map((item) => (
                    <a class="event-tile" href={item.href} tabindex={isDuplicate ? "-1" : undefined} draggable="false">
                      <Image
                        src={item.image}
                        alt={isDuplicate ? "" : item.alt}
                        widths={[420, 680]}
                        sizes="340px"
                        format="webp"
                        quality={84}
                      />
                      <span class="event-tile__shade"></span>
                      <span class="event-tile__copy">
                        <small>{item.label}</small>
                        <strong>{item.title}</strong>
                        <span>Explore <i aria-hidden="true">→</i></span>
                      </span>
                    </a>
                  ))}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section renaissance-feature">
      <div class="shell renaissance-feature__grid">
        <div class="renaissance-feature__cover">
          <Image
            src={renaissanceCover}
            alt="Cover of the Summer 2025 Al-Andalus issue of Renaissance"
            widths={[360, 620, 900]}
            sizes="(max-width: 760px) 68vw, 27vw"
            format="webp"
            quality={88}
          />
        </div>
        <div class="renaissance-feature__copy">
          <p class="eyebrow eyebrow--light">Renaissance · النهضة</p>
          <h2 class="display-serif">Ideas need a home, too.</h2>
          <p>
            Founded and led by Shaykh Hammad Mustafa al-Madani al-Qadri, Renaissance is a seasonal
            journal of Muslim thought connecting classical intellectual heritage to the questions
            of the present.
          </p>
          <div class="button-row">
            <a class="button button--light" href="/renaissance/">Explore the journal</a>
            <a class="button button--ghost" href="https://al-nahda.co.uk/" target="_blank" rel="noreferrer"
              >Visit Al-Nahda ↗</a
            >
          </div>
        </div>
      </div>
    </section>

    <section class="section section--compact">
      <div class="shell cta-band">
        <p class="eyebrow eyebrow--light">Your place is here</p>
        <h2>Help build what young Muslims need next.</h2>
        <p>Bring your energy, your skills and your questions. There is meaningful work to do.</p>
        <div class="button-row">
          <a class="button button--light" href="/get-involved/">Get involved</a>
          <a class="button button--ghost" href="/contact/">Talk to the team</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const viewport = document.querySelector<HTMLElement>(".event-marquee__viewport");
  const firstGroup = viewport?.querySelector<HTMLElement>(".event-marquee__group");

  if (viewport && firstGroup) {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let isDragging = false;
    let isPaused = false;
    let startX = 0;
    let startScrollLeft = 0;
    let lastFrame = performance.now();
    let resumeTimer: number | undefined;
    let suppressClick = false;

    const loopMarquee = () => {
      const groupWidth = firstGroup.getBoundingClientRect().width;

      if (groupWidth && viewport.scrollLeft >= groupWidth) {
        viewport.scrollLeft -= groupWidth;
      }
    };

    const pauseTemporarily = () => {
      isPaused = true;
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        isPaused = false;
        lastFrame = performance.now();
      }, 1600);
    };

    const animate = (time: number) => {
      const elapsed = Math.min(time - lastFrame, 50);
      lastFrame = time;

      if (!prefersReducedMotion.matches && !isPaused && !isDragging) {
        viewport.scrollLeft += elapsed * 0.035;
        loopMarquee();
      }

      window.requestAnimationFrame(animate);
    };

    viewport.addEventListener("pointerdown", (event) => {
      pauseTemporarily();

      if (event.pointerType !== "mouse" || event.button !== 0) return;

      isDragging = true;
      suppressClick = false;
      startX = event.clientX;
      startScrollLeft = viewport.scrollLeft;
      viewport.classList.add("is-dragging");
      viewport.setPointerCapture(event.pointerId);
    });

    viewport.addEventListener("pointermove", (event) => {
      if (!isDragging) return;

      const distance = event.clientX - startX;
      if (Math.abs(distance) > 4) suppressClick = true;
      viewport.scrollLeft = startScrollLeft - distance;
    });

    const stopDragging = () => {
      if (!isDragging) return;
      isDragging = false;
      viewport.classList.remove("is-dragging");
      pauseTemporarily();
      window.setTimeout(() => {
        suppressClick = false;
      }, 0);
    };

    viewport.addEventListener("pointerup", stopDragging);
    viewport.addEventListener("pointercancel", stopDragging);
    viewport.addEventListener("wheel", pauseTemporarily, { passive: true });
    viewport.addEventListener("keydown", pauseTemporarily);
    viewport.addEventListener("scroll", loopMarquee, { passive: true });
    viewport.addEventListener("click", (event) => {
      if (!suppressClick) return;
      event.preventDefault();
      event.stopPropagation();
      suppressClick = false;
    }, true);

    window.requestAnimationFrame(animate);
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    height: 100svh;
    background: #061d1d;
    color: var(--white);
  }

  .hero::before {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(2 28 27 / 0.98) 0%, rgb(3 31 28 / 0.88) 34%, rgb(3 28 27 / 0.48) 62%, rgb(3 20 22 / 0.2) 100%),
      linear-gradient(0deg, rgb(2 19 21 / 0.86) 0%, transparent 48%),
      radial-gradient(circle at 62% 4%, rgb(177 108 54 / 0.24), transparent 38%);
    pointer-events: none;
  }

  .hero::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(90deg, rgb(3 35 32 / 0.42), transparent 24% 84%, rgb(3 20 22 / 0.46));
    pointer-events: none;
  }

  .hero__background {
    position: absolute;
    z-index: 0;
    width: 100%;
    height: 100%;
    inset: 0;
    object-fit: cover;
    object-position: center 50%;
  }

  .hero__stage {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    height: 100%;
    padding-top: clamp(7rem, 13vh, 9rem);
    padding-bottom: clamp(1.35rem, 3vh, 2rem);
  }

  .hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(340px, 0.72fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5.5rem);
    min-height: 0;
  }

  .hero__message {
    width: min(100%, 720px);
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 42px;
    padding: 0.6rem 1.05rem;
    border: 1px solid rgb(239 33 57 / 0.82);
    border-radius: 999px;
    color: rgb(255 255 255 / 0.88);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .hero__eyebrow svg {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .hero h1 {
    max-width: 12ch;
    margin-top: clamp(1.35rem, 3vh, 2rem);
    color: var(--white);
    font-size: clamp(3.7rem, 5.5vw, 6.3rem);
    letter-spacing: -0.055em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .hero h1 span {
    color: #f52b48;
    font-family: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
  }

  .hero__rule {
    display: block;
    width: clamp(5rem, 11vw, 10rem);
    height: 4px;
    margin-top: clamp(1.5rem, 3.2vh, 2.4rem);
    border-radius: 99px;
    background: var(--red);
  }

  .hero__lead {
    max-width: 49ch;
    margin-top: clamp(1.35rem, 2.8vh, 2rem);
    color: rgb(255 255 255 / 0.82);
    font-size: clamp(1rem, 1.12vw, 1.13rem);
    line-height: 1.58;
  }

  .hero__message .button-row {
    margin-top: clamp(1.5rem, 3.2vh, 2.35rem);
  }

  .hero__message .button {
    min-height: 3.5rem;
    padding-inline: 1.55rem;
  }

  .hero__visual {
    position: relative;
    justify-self: end;
    width: min(100%, 470px);
    height: min(62vh, 610px);
    min-height: 430px;
    margin: 0;
    isolation: isolate;
  }

  .hero__visual::before,
  .hero__visual-frame {
    content: "";
    position: absolute;
    border: 2px solid rgb(212 231 225 / 0.38);
    border-radius: 1.7rem;
    background: rgb(44 83 75 / 0.18);
    backdrop-filter: blur(5px);
  }

  .hero__visual::before {
    z-index: -2;
    inset: 5% -7% -5% 9%;
    transform: rotate(5deg);
  }

  .hero__visual-frame {
    z-index: -1;
    inset: 1% -2% 3% 4%;
    transform: rotate(-3deg);
  }

  .hero__visual-card {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    border: 2px solid rgb(255 255 255 / 0.75);
    border-radius: 1.7rem;
    background:
      radial-gradient(circle at 72% 20%, rgb(212 143 86 / 0.34), transparent 35%),
      linear-gradient(145deg, #275d50, #071f20 76%);
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 0.42);
  }

  .hero__visual-card::after {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 0;
    background: linear-gradient(0deg, rgb(3 19 20 / 0.56), transparent 44%);
    pointer-events: none;
  }

  .hero__visual-card :global(img) {
    position: absolute;
    z-index: 1;
    width: 109%;
    max-width: none;
    height: auto;
    left: -4%;
    bottom: -5%;
    filter: drop-shadow(0 1.5rem 2rem rgb(0 0 0 / 0.46));
  }

  .hero__visual figcaption {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    right: 1rem;
    bottom: 1rem;
    left: -1.5rem;
    padding: 0.9rem 1.15rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 1.15rem;
    background: rgb(5 23 27 / 0.88);
    box-shadow: 0 1rem 2.6rem rgb(0 0 0 / 0.3);
    backdrop-filter: blur(14px);
  }

  .hero__visual-mark {
    display: grid;
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid var(--red);
    border-radius: 50%;
    color: var(--red);
  }

  .hero__visual-mark svg {
    fill: none;
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .hero__visual figcaption > span:last-child {
    display: grid;
    gap: 0.18rem;
  }

  .hero__visual figcaption strong {
    font-family: var(--font-display);
    font-size: 0.73rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__visual figcaption small {
    color: rgb(255 255 255 / 0.66);
    font-size: 0.74rem;
  }

  .events-showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    background:
      radial-gradient(circle at 12% 16%, rgb(22 105 78 / 0.08), transparent 23rem),
      radial-gradient(circle at 92% 45%, rgb(239 33 57 / 0.065), transparent 27rem),
      var(--cream);
  }

  .events-showcase::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.32;
    background-image: radial-gradient(circle, rgb(15 75 56 / 0.16) 1px, transparent 1.5px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }

  .events-showcase__heading {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .events-showcase__heading h2 {
    max-width: 15ch;
    margin-top: 1rem;
  }

  .events-showcase__heading h2 span,
  .event-feature__copy h3 span {
    color: var(--red);
    font-family: var(--font-serif);
    font-weight: 500;
  }

  .events-showcase__heading > p:last-child {
    max-width: 68ch;
    margin-top: 1.35rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .event-features {
    display: grid;
    gap: clamp(4.5rem, 10vw, 8rem);
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .event-feature {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
    align-items: center;
    gap: clamp(2.5rem, 7vw, 7rem);
  }

  .event-feature--reverse {
    grid-template-columns: minmax(340px, 0.92fr) minmax(0, 1.08fr);
  }

  .event-feature--reverse .event-feature__media {
    order: 2;
  }

  .event-feature__media {
    position: relative;
    margin: 0;
    overflow: visible;
  }

  .event-feature__media::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 1.2rem -1.2rem -1.2rem 1.2rem;
    border: 1px solid rgb(17 84 63 / 0.3);
    border-radius: var(--radius-lg);
  }

  .event-feature--reverse .event-feature__media::before {
    inset: 1.2rem 1.2rem -1.2rem -1.2rem;
    border-color: rgb(239 33 57 / 0.24);
  }

  .event-feature__media :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1.28;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .event-feature__metric {
    position: absolute;
    top: clamp(1rem, 2.5vw, 2rem);
    right: clamp(-1rem, -1.5vw, -1.5rem);
    display: grid;
    min-width: 9.5rem;
    padding: 0.9rem 1.05rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 0.65rem;
    background: rgb(4 39 33 / 0.94);
    color: rgb(255 255 255 / 0.76);
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
    box-shadow: 0 16px 34px rgb(6 34 27 / 0.24);
    backdrop-filter: blur(10px);
  }

  .event-feature--reverse .event-feature__metric {
    right: auto;
    left: clamp(-1rem, -1.5vw, -1.5rem);
  }

  .event-feature__metric strong {
    color: #ff526b;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.45rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
  }

  .event-feature__index {
    color: var(--red);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .event-feature__copy h3 {
    max-width: 12ch;
    margin-top: 0.9rem;
    font-size: clamp(2.8rem, 5vw, 5.3rem);
