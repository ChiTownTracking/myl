---
import { Image } from "astro:assets";
import Layout from "../../../layouts/Layout.astro";
import PageHero from "../../../components/PageHero.astro";
import SectionIntro from "../../../components/SectionIntro.astro";
import { sourceLinks } from "../../../data/site.js";
import heroImage from "../../../assets/images/al-hidayah/al-hidayah-2025.jpg";
import keynoteImage from "../../../assets/images/al-hidayah/al-hidayah-2026-keynote.jpg";
import workshopImage from "../../../assets/images/al-hidayah/al-hidayah-2026-workshop.jpg";
import audienceImage from "../../../assets/images/al-hidayah/al-hidayah-2023-gathering.jpg";
import portraitImage from "../../../assets/images/al-hidayah/al-hidayah-2023-keynote.jpg";
import teachingImage from "../../../assets/images/al-hidayah/al-hidayah-community.jpeg";
---

<Layout
  title="Al-Hidayah Canada"
  description="Learn about Al-Hidayah Canada, the MQI Canada residential retreat supported by MYL Canada volunteers, including the 2026 theme and program."
  image={heroImage}
>
  <main id="main">
    <PageHero
      eyebrow="MQI Canada retreat · MYL volunteer-supported"
      title="Pure intentions. Noble conduct."
      intro="Al-Hidayah is a residential learning and spiritual retreat where scholarship, worship and companionship come together. The 2026 Canadian edition was organized by Minhaj-ul-Quran International Canada, with MYL Canada volunteers supporting registration and event delivery."
      image={heroImage}
      imageAlt="A speaker addressing a full Al-Hidayah auditorium"
      tone="dark"
      meta={[
        { label: "2026 edition", value: "August 1–3" },
        { label: "Venue", value: "McMaster University" },
        { label: "Location", value: "Hamilton, Ontario" },
      ]}
    />

    <section class="section retreat-intro">
      <div class="shell retreat-intro__grid">
        <div>
          <p class="eyebrow">About the retreat</p>
          <h2>Step away from noise. Return with direction.</h2>
        </div>
        <div class="prose">
          <p class="lead">
            Al-Hidayah is designed as a complete residential experience: learning, worship,
            reflection and community under one roof.
          </p>
          <p>
            The retreat’s public program describes an environment for rediscovering faith,
            strengthening understanding and refining character. Rather than treating knowledge as
            information alone, Al-Hidayah asks how it shapes intention, balance and contribution to
            the world around us.
          </p>
          <div class="relationship-note">
            <strong>Who organizes it?</strong>
            <span>
              Al-Hidayah Canada is an MQI Canada initiative. MYL Canada’s documented role is volunteer
              support, including registration and event delivery.
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="numbers">
      <div class="shell numbers__grid">
        <div><strong>3</strong><span>Residential days</span></div>
        <div><strong>500+</strong><span>Participants listed by the official site</span></div>
        <div><strong>10+</strong><span>Speakers listed by the official site</span></div>
        <div><strong>1</strong><span>Shared journey of renewal</span></div>
      </div>
    </section>

    <section class="section outcomes">
      <div class="shell">
        <SectionIntro
          eyebrow="Why Al-Hidayah"
          title="Formation for mind, heart and character."
          intro="The retreat’s official program is organized around five connected outcomes."
        />
        <div class="outcomes__grid">
          <article><span>01</span><h3>Discover purpose</h3><p>Grow through reflection, knowledge and sincere companionship.</p></article>
          <article><span>02</span><h3>Learn from scholars</h3><p>Encounter timeless Islamic wisdom through clear, relatable teaching.</p></article>
          <article><span>03</span><h3>Build fellowship</h3><p>Form bonds with fellow seekers united by faith and a shared journey.</p></article>
          <article><span>04</span><h3>Clarify questions</h3><p>Address misconceptions and modern challenges through balanced knowledge.</p></article>
          <article><span>05</span><h3>Cultivate character</h3><p>Refine humility, sincerity and moral excellence—not only what you know, but who you are.</p></article>
        </div>
      </div>
    </section>

    <section class="section section--cream speakers">
      <div class="shell speakers__grid">
        <figure class="speakers__image">
          <Image
            src={keynoteImage}
            alt="Shaykh-ul-Islam Dr Muhammad Tahir-ul-Qadri teaching at Al-Hidayah Canada 2026"
            widths={[680, 1100]}
            sizes="(max-width: 900px) 92vw, 52vw"
            format="webp"
            quality={86}
          />
        </figure>
        <div>
          <p class="eyebrow">2026 featured teachers</p>
          <h2>Scholarship across generations.</h2>
          <p class="lead speakers__lead">
            The official 2026 program featured senior scholars, teachers and leaders addressing
            spiritual depth, intellectual clarity and contemporary life.
          </p>
          <ul>
            <li><strong>Shaykh-ul-Islam Dr Muhammad Tahir-ul-Qadri</strong><span>Founder, Minhaj-ul-Quran International</span></li>
            <li><strong>Dr Hassan Mohi-ud-Din Qadri</strong><span>Chairman, MQI Supreme Council</span></li>
            <li><strong>Shaykh Hammad Mustafa al-Madani al-Qadri</strong><span>Scholar and youth educator</span></li>
            <li><strong>Dr Ghazala Hassan Qadri</strong><span>Educator and women’s leadership advocate</span></li>
          </ul>
          <a class="text-link" href={sourceLinks.alHidayah} target="_blank" rel="noreferrer">Visit the official Al-Hidayah site ↗</a>
        </div>
      </div>
    </section>

    <section class="section gallery">
      <div class="shell">
        <SectionIntro
          eyebrow="Inside Al-Hidayah"
          title="Learning that fills the room."
          intro="Official event photography from Al-Hidayah Canada gatherings and teaching sessions."
        />
        <div class="gallery__grid">
          <figure class="gallery__wide">
            <Image src={audienceImage} alt="A large audience gathered at Al-Hidayah" widths={[760, 1200]} sizes="(max-width: 760px) 92vw, 58vw" format="webp" />
            <figcaption>Community and companionship</figcaption>
          </figure>
          <figure>
            <Image src={workshopImage} alt="An interactive workshop at Al-Hidayah Canada 2026" widths={[520, 850]} sizes="(max-width: 760px) 92vw, 34vw" format="webp" />
            <figcaption>Interactive learning · 2026</figcaption>
          </figure>
          <figure>
            <Image src={portraitImage} alt="Dr Muhammad Tahir-ul-Qadri speaking at Al-Hidayah" widths={[520, 850]} sizes="(max-width: 760px) 92vw, 34vw" format="webp" />
            <figcaption>Focused teaching</figcaption>
          </figure>
          <figure>
            <Image src={teachingImage} alt="Teaching from the Al-Hidayah stage" widths={[520, 850]} sizes="(max-width: 760px) 92vw, 34vw" format="webp" />
            <figcaption>Knowledge in practice</figcaption>
          </figure>
        </div>
        <p class="source-note gallery__source">
          Images and event details are sourced from the official Al-Hidayah and Minhaj reports.
        </p>
      </div>
    </section>

    <section class="section section--compact">
      <div class="shell hidayah-cta">
        <div>
          <p class="eyebrow eyebrow--light">Al-Hidayah Canada</p>
          <h2>Explore the official retreat archive.</h2>
        </div>
        <div>
          <p>
            Registration status, future editions and definitive program details are maintained by the Al-Hidayah organizers.
          </p>
          <a class="button button--light" href={sourceLinks.alHidayah} target="_blank" rel="noreferrer">Official Al-Hidayah site ↗</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .retreat-intro__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .retreat-intro h2 {
    max-width: 11ch;
    margin-top: 1rem;
  }

  .relationship-note {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border-left: 4px solid var(--red);
    background: var(--red-soft);
  }

  .relationship-note span {
    color: var(--muted);
  }

  .numbers {
    background: var(--green-deep);
    color: var(--white);
  }

  .numbers__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .numbers__grid > div {
    padding: clamp(2rem, 4vw, 3.5rem) 1rem;
  }

  .numbers__grid > div + div {
    border-left: 1px solid rgb(255 255 255 / 0.16);
  }

  .numbers strong,
  .numbers span {
    display: block;
  }

  .numbers strong {
    color: #ff9aa8;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 500;
    line-height: 1;
  }

  .numbers span {
    margin-top: 0.6rem;
    color: rgb(255 255 255 / 0.66);
    font-size: 0.82rem;
  }

  .outcomes__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin-top: 3rem;
    border-block: 1px solid var(--line);
  }

  .outcomes article {
    min-height: 310px;
    padding: 1.5rem 1.2rem 1.5rem 0;
  }

  .outcomes article + article {
    padding-left: 1.2rem;
    border-left: 1px solid var(--line);
  }

  .outcomes article > span {
    color: var(--red);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .outcomes h3 {
    margin-top: 4.5rem;
  }

  .outcomes article p {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .speakers__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
  }

  .speakers__image {
    margin: 0;
    overflow: hidden;
    min-height: 600px;
    border-radius: var(--radius-lg);
    background: var(--green-deep);
  }

  .speakers__image :global(img) {
    width: 100%;
    height: 100%;
    min-height: 600px;
    object-fit: cover;
  }

  .speakers h2 {
    margin-top: 1rem;
  }

  .speakers__lead {
    margin-top: 1.3rem;
  }

  .speakers ul {
    padding: 0;
    margin: 1.6rem 0;
    list-style: none;
    border-top: 1px solid var(--cream-deep);
  }

  .speakers li {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--cream-deep);
  }

  .speakers li strong,
  .speakers li span {
    display: block;
  }

  .speakers li span {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    grid-template-rows: repeat(3, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .gallery figure {
    position: relative;
    margin: 0;
    overflow: hidden;
    min-height: 250px;
    border-radius: var(--radius);
    background: var(--cream);
  }

  .gallery__wide {
    grid-row: 1 / 4;
  }

  .gallery figure :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.5rem 1rem 1rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.78));
    color: var(--white);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .gallery__source {
    margin-top: 1rem;
  }

  .hidayah-cta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background: #182353;
    color: var(--white);
  }

  .hidayah-cta h2 {
    margin-top: 1rem;
  }

  .hidayah-cta > div:last-child > p {
    margin-bottom: 1.6rem;
    color: rgb(255 255 255 / 0.72);
  }

  @media (max-width: 950px) {
    .outcomes__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .outcomes article:nth-child(odd) {
      border-left: 0;
    }

    .outcomes article:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 820px) {
    .retreat-intro__grid,
    .speakers__grid,
    .hidayah-cta {
      grid-template-columns: 1fr;
    }

    .numbers__grid {
      grid-template-columns: 1fr 1fr;
    }

    .numbers__grid > div:nth-child(3) {
      border-top: 1px solid rgb(255 255 255 / 0.16);
      border-left: 0;
    }

    .numbers__grid > div:nth-child(4) {
      border-top: 1px solid rgb(255 255 255 / 0.16);
    }

    .gallery__grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .gallery__wide {
      grid-row: auto;
    }
  }

  @media (max-width: 580px) {
    .relationship-note,
    .outcomes__grid {
      grid-template-columns: 1fr;
    }

    .outcomes article,
    .outcomes article + article {
      min-height: auto;
      padding: 1.4rem 0;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .outcomes h3 {
      margin-top: 1.5rem;
    }

    .speakers__image,
    .speakers__image :global(img) {
      min-height: 390px;
    }
  }
</style>
