---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import SlimHero from "../../components/SlimHero.astro";
import ProgramDirectory from "../../components/ProgramDirectory.astro";
import { featuredGathering as featured, retreatAnnouncement, eventHighlights } from "../../data/activities";
import qaCommunity from "../../assets/images/myl-qa-2026/myl-qa-2026-community.jpg";
---

<Layout title="Events & Programs"
  description="Discover MYL Canada’s major events and programs: Al-Rahma, Al-Hidayah, Burdah Night, Mawlid, Al-Hikmah, youth Q&As, I’tikaf and Hoops 4 Humanity. Explore photos, posters and event highlights."
  image={qaCommunity}>
  <main id="main">
    <SlimHero titleId="events-hero-title" eyebrow="Events & Programs"
      title="Find your people. Grow your purpose."
      intro="From a shared question to a packed conference hall, there’s a place for you here. Discover the gatherings, learning and community that bring MYL Canada to life."
      tone="red" facts={[
        { label: "Learn", value: "Talks & workshops" },
        { label: "Connect", value: "Retreats & gatherings" },
        { label: "Take part", value: "Sport & service" },
      ]} />

    <nav class="page-nav" aria-label="On this page">
      <div class="shell page-nav__inner">
        <a href="#burdah-night">Latest gathering <span aria-hidden="true">↓</span></a>
        <a href="#programs">Explore programs <span aria-hidden="true">↓</span></a>
        <a href="#event-highlights">Event highlights <span aria-hidden="true">↓</span></a>
        <a href="#stay-connected">Stay connected <span aria-hidden="true">↓</span></a>
      </div>
    </nav>

    <section class="section section--compact featured" id="burdah-night" aria-labelledby="featured-title">
      <div class="shell">
        <div class="featured__card">
          <a class="featured__poster" href={featured.source} target="_blank" rel="noopener noreferrer" aria-label="View the original Burdah Night announcement on Instagram">
            <Image src={featured.image} alt={featured.imageAlt} widths={[360, 480, 720]}
              sizes="(max-width: 740px) 85vw, 400px" format="webp" loading="eager" fetchpriority="high" />
          </a>
          <div class="featured__copy">
            <p class="eyebrow">From the MYL community</p>
            <h2 id="featured-title">Burdah <em>Night.</em></h2>
            <p class="featured__subtitle">An evening of praising the Beloved ﷺ</p>
            <p class="featured__description">{featured.description}</p>
            <dl class="featured__details">
              <div><dt>When</dt><dd><time datetime={featured.datetime}>{featured.date}</time> · {featured.time}</dd></div>
              <div><dt>Where</dt><dd>{featured.venue}<span>{featured.address}</span></dd></div>
            </dl>
            <a class="button" href={featured.source} target="_blank" rel="noopener noreferrer">View event announcement <span aria-hidden="true">↗</span></a>
            <p class="featured__credit">Original event poster from MYL Canada’s Instagram.</p>
          </div>
        </div>
        <aside class="announcement" aria-labelledby="announcement-title">
          <Image src={retreatAnnouncement.image} alt="Official announcement that Al-Hidayah is returning to Canada in 2028" width={120} height={120} format="webp" loading="lazy" />
          <div>
            <p class="announcement__eyebrow">Looking ahead · MQI Canada</p>
            <h3 id="announcement-title">{retreatAnnouncement.title}</h3>
            <p>{retreatAnnouncement.description}</p>
          </div>
          <a href={retreatAnnouncement.source} target="_blank" rel="noopener noreferrer">Read the announcement <span aria-hidden="true">↗</span></a>
        </aside>
      </div>
    </section>

    <section class="section section--cream" id="programs" aria-labelledby="programs-heading">
      <div class="shell">
        <div class="section-heading">
          <p class="eyebrow">Find your way in</p>
          <h2 id="programs-heading">A community.<br /><em>Many ways to belong.</em></h2>
          <p class="lead">Learn with a scholar, join a team, share a spiritual journey or listen to a new perspective. Explore our main programs and community collaborations.</p>
        </div>
        <ProgramDirectory />
      </div>
    </section>

    <section class="section highlights" id="event-highlights" aria-labelledby="highlights-heading">
      <div class="shell">
        <div class="highlights__intro">
          <div class="section-heading">
            <p class="eyebrow">Moments that bring us together</p>
            <h2 id="highlights-heading">From our gatherings.</h2>
            <p class="lead">Look back at recent events and landmark conferences through original posters, photographs and community recaps.</p>
          </div>
          <a class="text-link" href="/gallery/">Visit the gallery <span aria-hidden="true">↗</span></a>
        </div>
        <div class="highlights__grid">
          {eventHighlights.map((event) => (
            <article class="highlight-card" id={event.id}>
              <div class:list={["highlight-card__media", { "highlight-card__media--poster": event.imageStyle === "poster" }]}>
                <Image src={event.image} alt={event.imageAlt} widths={[360, 640, 900]}
                  sizes="(max-width: 620px) 92vw, (max-width: 1000px) 46vw, 390px" format="webp" loading="lazy" decoding="async" />
                <span class="highlight-card__badge">Past event</span>
              </div>
              <div class="highlight-card__body">
                <time datetime={event.datetime}>{event.date}</time>
                <h3>{event.title}</h3>
                <p class="highlight-card__location">{event.location}</p>
                <p class="highlight-card__description">{event.description}</p>
                <div class="highlight-card__links">
                  <a class="highlight-card__primary" href={event.href} target={event.href.startsWith("https://") ? "_blank" : undefined} rel={event.href.startsWith("https://") ? "noopener noreferrer" : undefined}>
                    {event.linkLabel} <span aria-hidden="true">↗</span>
                  </a>
                  {event.source !== event.href && <a class="highlight-card__source" href={event.source} target="_blank" rel="noopener noreferrer">{event.sourceLabel} <span aria-hidden="true">↗</span></a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--compact social-section" id="stay-connected">
      <div class="shell social-card">
        <div>
          <p class="eyebrow eyebrow--light">You’re invited</p>
          <h2>Be part of<br /><em>what comes next.</em></h2>
          <p>Follow MYL Canada for new gatherings, registration announcements and moments from the community.</p>
          <div class="button-row">
            <a class="button button--light" href="https://www.instagram.com/mylcanada/" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
            <a class="button button--ghost" href="https://www.facebook.com/MYLCanada" target="_blank" rel="noopener noreferrer">Facebook <span aria-hidden="true">↗</span></a>
          </div>
          <a class="social-card__volunteer" href="/get-involved/">Want to help make it happen? Volunteer with MYL <span aria-hidden="true">→</span></a>
        </div>
        <div class="social-card__photo">
          <Image src={qaCommunity} alt="The MYL Canada community gathered with scholars at Jamia Al Mustafa" widths={[480, 800, 1100]} sizes="(max-width: 850px) 90vw, 48vw" format="webp" loading="lazy" />
          <span>Love · Peace · Knowledge</span>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  section[id], article[id] { scroll-margin-top: 8rem; }
  .page-nav { border-bottom: 1px solid var(--line); }
  .page-nav__inner { display: flex; flex-wrap: wrap; gap: 0.4rem 2rem; padding-block: 1rem; }
  .page-nav a { display: inline-flex; align-items: center; gap: 0.75rem; padding-block: 0.3rem; color: var(--green-deep); font-size: 0.78rem; font-weight: 700; }
  .page-nav a:hover { text-decoration: underline; text-underline-offset: 0.3em; }
  .featured__card { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--cream); }
  .featured__poster { display: grid; place-items: center; padding: clamp(1rem, 2.5vw, 2rem); background: #e6ddc6; }
  .featured__poster :global(img) { width: auto; max-width: 100%; height: auto; max-height: 570px; object-fit: contain; box-shadow: 0 10px 35px rgb(33 28 15 / 0.15); }
  .featured__copy { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(1.5rem, 4vw, 3.5rem); }
  .featured h2 { margin-top: 1rem; font-size: clamp(2.8rem, 5vw, 4.5rem); }
  h2 em { font-family: var(--font-serif); font-weight: 500; }
  .featured__subtitle { margin-top: 0.8rem; color: var(--green-deep); font-family: var(--font-serif); font-size: 1.2rem; }
  .featured__description { max-width: 54ch; margin-top: 1rem; color: var(--muted); font-size: 0.95rem; }
  .featured__details { width: 100%; margin-block: 1.4rem 1.6rem; padding-top: 1rem; border-top: 1px solid #d8cebc; }
  .featured__details > div { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.75rem; margin-bottom: 0.7rem; }
  .featured__details dt { padding-top: 0.15rem; color: var(--red-deep); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .featured__details dd { margin: 0; font-size: 0.9rem; font-weight: 700; }
  .featured__details dd span { display: block; color: var(--muted); font-size: 0.78rem; font-weight: 400; }
  .featured__credit { margin-top: 1rem; color: var(--muted); font-size: 0.7rem; }
  .announcement { display: grid; grid-template-columns: 90px 1fr auto; align-items: center; gap: 1.5rem; margin-top: 1.3rem; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .announcement :global(img) { width: 90px; height: 90px; border-radius: 0.65rem; }
  .announcement__eyebrow { color: var(--red-deep); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .announcement h3 { margin-block: 0.35rem; font-family: var(--font-serif); font-size: 1.5rem; letter-spacing: -0.02em; }
  .announcement p:last-child { max-width: 67ch; color: var(--muted); font-size: 0.84rem; }
  .announcement > a { color: var(--green-deep); font-size: 0.77rem; font-weight: 800; }
  .section-heading h2 { max-width: 22ch; margin-top: 1rem; font-size: clamp(2.25rem, 4vw, 3.65rem); }
  .section-heading .lead { max-width: 65ch; margin-top: 1.2rem; font-size: 1.05rem; }
  .highlights__intro { display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .highlights__intro > a { flex-shrink: 0; margin-bottom: 0.4rem; }
  .highlights__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; margin-top: 2.75rem; }
  .highlight-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); }
  .highlight-card__media { position: relative; aspect-ratio: 4 / 3; background: var(--cream); }
  .highlight-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .highlight-card__media--poster { padding: 0.8rem; background: #eee6d9; }
  .highlight-card__media--poster :global(img) { object-fit: contain; }
  .highlight-card__badge { position: absolute; top: 0.85rem; left: 0.85rem; padding: 0.3rem 0.65rem; border-radius: 99px; background: var(--paper); color: var(--green-deep); font-size: 0.65rem; font-weight: 800; }
  .highlight-card__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1.5rem; }
  .highlight-card time { color: var(--red-deep); font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; }
  .highlight-card h3 { margin-top: 0.65rem; font-family: var(--font-serif); font-size: 1.65rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
  .highlight-card__location { margin-top: 0.75rem; color: var(--green-deep); font-size: 0.73rem; font-weight: 700; }
  .highlight-card__description { margin-top: 0.8rem; padding-bottom: 1.5rem; color: var(--muted); font-size: 0.9rem; }
  .highlight-card__links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.65rem; width: 100%; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--line); }
  .highlight-card__primary { color: var(--green-deep); font-size: 0.8rem; font-weight: 800; }
  .highlight-card__source { color: var(--muted); font-size: 0.7rem; }
  .highlight-card a:hover, .announcement > a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .social-section { padding-top: 0; }
  .social-card { display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; border-radius: var(--radius-lg); background: var(--green-deep); color: var(--white); }
  .social-card > div:first-child { padding: clamp(1.5rem, 4vw, 3.5rem); }
  .social-card h2 { margin-top: 1rem; font-size: clamp(2.25rem, 4vw, 3.5rem); }
  .social-card p:not(.eyebrow) { max-width: 44ch; margin-top: 1.2rem; color: rgb(255 255 255 / 0.8); font-size: 0.94rem; }
  .social-card__volunteer { display: inline-block; margin-top: 1.6rem; color: #cde5d5; font-size: 0.77rem; text-decoration: underline; text-underline-offset: 0.25em; }
  .social-card__photo { position: relative; min-height: 360px; }
  .social-card__photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .social-card__photo span { position: absolute; inset: auto 0 0; padding: 3rem 1.5rem 1.5rem; background: linear-gradient(transparent, rgb(0 0 0 / 0.65)); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; }
  @media (max-width: 1000px) {
    .highlights__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .announcement { grid-template-columns: 90px 1fr; }
    .announcement > a { grid-column: 2; }
    .highlights__intro { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 850px) { .social-card { grid-template-columns: 1fr; } }
  @media (max-width: 740px) {
    .featured__card { grid-template-columns: 1fr; }
    .featured__poster :global(img) { max-height: 500px; }
    .page-nav__inner { gap: 0.35rem 1.1rem; }
    .page-nav a { font-size: 0.72rem; }
  }
  @media (max-width: 620px) {
    .highlights__grid { grid-template-columns: minmax(0, 1fr); }
    .announcement { grid-template-columns: 65px minmax(0, 1fr); gap: 0.75rem; }
    .announcement :global(img) { width: 65px; height: 65px; }
    .announcement h3 { font-size: 1.25rem; }
    .featured .button { font-size: 0.72rem; padding-inline: 1rem; }
  }
</style>
