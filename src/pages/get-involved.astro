---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SlimHero from "../components/SlimHero.astro";
import SectionIntro from "../components/SectionIntro.astro";
import { contactForm, organization } from "../data/site.js";
import qaGroup from "../assets/images/myl-qa-2026/myl-qa-2026-stage.jpg";
import hoodieImage from "../assets/images/herosection/myl-back-hoodies.png";
import hoopsTeam from "../assets/images/hoops4humanity/myl-basketball.png";

const volunteerEmail = `mailto:${organization.email}?subject=MYL%20Canada%20Volunteer%20Interest`;
---

<Layout
  title="Get Involved"
  description="Volunteer with MYL Canada and contribute to events, learning programs, sports, media, outreach and community service."
  image={qaGroup}
>
  <main id="main">
    <SlimHero
      titleId="get-involved-hero-title"
      eyebrow="Get involved"
      title="Do meaningful work with good people."
      intro="MYL Canada is built by people willing to carry a real piece of the work. Bring your reliability, your curiosity and the skills you are still developing."
      facts={[
        { label: "Bring", value: "Consistency" },
        { label: "Build", value: "Useful skills" },
        { label: "Become", value: "Part of the team" },
      ]}
    />

    <section class="section invitation" aria-labelledby="invitation-title">
      <div class="shell invitation__inner">
        <div class="invitation__head">
          <p class="eyebrow">Volunteer with MYL</p>
          <h2 id="invitation-title">Put your name forward.</h2>
        </div>

        <form
          class="site-form invitation__form"
          data-site-form
          data-endpoint={contactForm.endpoint}
          data-fallback-email={organization.email}
          data-subject="MYL Canada Volunteer Interest"
          novalidate
        >
          <div class="site-form__row invitation__row--three">
            <p class="field">
              <label for="vf-name">Name</label>
              <input
                id="vf-name"
                name="name"
                type="text"
                autocomplete="name"
                minlength="2"
                data-error-message="Please enter your name."
                required
              />
              <span class="field__error" id="vf-name-error" data-error-for="name" hidden></span>
            </p>
            <p class="field">
              <label for="vf-email">Email</label>
              <input
                id="vf-email"
                name="email"
                type="email"
                autocomplete="email"
                data-error-message="Please enter a valid email address."
                required
              />
              <span class="field__error" id="vf-email-error" data-error-for="email" hidden></span>
            </p>
            <p class="field">
              <label for="vf-city">City</label>
              <input
                id="vf-city"
                name="city"
                type="text"
                autocomplete="address-level2"
                data-error-message="Please tell us which city you are in."
                required
              />
              <span class="field__error" id="vf-city-error" data-error-for="city" hidden></span>
            </p>
          </div>

          <div class="site-form__row">
            <p class="field">
              <label for="vf-area">Where you would like to help</label>
              <select id="vf-area" name="area">
                <option>Not sure yet — place me where needed</option>
                <option>Event operations</option>
                <option>Media &amp; design</option>
                <option>Learning programs</option>
                <option>Sports &amp; recreation</option>
                <option>Community outreach</option>
                <option>General team</option>
              </select>
            </p>
            <p class="field">
              <label for="vf-availability">Availability</label>
              <select id="vf-availability" name="availability">
                <option>Weekends</option>
                <option>Weekday evenings</option>
                <option>Event days only</option>
                <option>Flexible</option>
              </select>
            </p>
          </div>

          <p class="field">
            <label for="vf-about">Anything else</label>
            <textarea id="vf-about" name="about" rows="3"></textarea>
          </p>

          <p class="site-form__trap" aria-hidden="true">
            <label for="vf-company">Company</label>
            <input id="vf-company" name="company" type="text" tabindex="-1" autocomplete="off" />
          </p>

          <div class="site-form__actions">
            <button class="button" type="submit">Send my interest</button>
            <span class="site-form__status" data-form-status role="status" aria-live="polite"></span>
          </div>
        </form>
      </div>
    </section>

    <section class="section section--cream roles">
      <div class="shell">
        <SectionIntro
          eyebrow="Ways to contribute"
          title="Find the work that fits your strengths."
          intro="Needs change from event to event, but these are the teams most often required to turn a good idea into a strong experience."
        />
        <div class="roles__grid">
          <article><span>01</span><h3>Event operations</h3><p>Set-up, registration, guest care, room flow, vendors and the details that keep a gathering moving.</p></article>
          <article><span>02</span><h3>Media & design</h3><p>Photography, video, graphics, writing and social content that communicates the work clearly.</p></article>
          <article><span>03</span><h3>Learning programs</h3><p>Speaker coordination, session support, research, notes and welcoming spaces for good questions.</p></article>
          <article><span>04</span><h3>Sports & recreation</h3><p>Game logistics, team communication, check-in, officiating support and a positive court culture.</p></article>
          <article><span>05</span><h3>Community outreach</h3><p>Partnerships, local promotion, service drives and making sure new people feel invited.</p></article>
          <article><span>06</span><h3>General team</h3><p>Come ready to help where the need is greatest and learn the organization from the ground up.</p></article>
        </div>
      </div>
    </section>

    <section class="section expectations">
      <div class="shell expectations__grid">
        <figure>
          <Image
            src={hoodieImage}
            alt="Two volunteers wearing Muslim Youth League Canada hoodies"
            widths={[500, 800, 1051]}
            sizes="(max-width: 840px) 78vw, 38vw"
            format="webp"
            quality={88}
          />
        </figure>
        <div>
          <p class="eyebrow">What good volunteering looks like</p>
          <h2>Warmth in spirit. Excellence in delivery.</h2>
          <ol>
            <li><span>01</span><div><h3>Be reliable</h3><p>Say what you can do, then do it—or communicate early when something changes.</p></div></li>
            <li><span>02</span><div><h3>Stay teachable</h3><p>Ask questions, receive feedback and leave each project more capable than you entered.</p></div></li>
            <li><span>03</span><div><h3>Protect the atmosphere</h3><p>Treat guests, teammates and community members with patience, discretion and respect.</p></div></li>
            <li><span>04</span><div><h3>Finish well</h3><p>The last details, follow-up and clean-up are part of the service too.</p></div></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="team-photo">
      <Image src={hoopsTeam} alt="MYL Canada basketball players, organizers and community members" widths={[900, 1600, 2400]} sizes="100vw" format="webp" quality={82} />
      <div class="team-photo__overlay">
        <div class="shell">
          <p class="eyebrow eyebrow--light">Come build with us</p>
          <h2>The team gets stronger when you show up.</h2>
        </div>
      </div>
    </section>

    <section class="section start">
      <div class="shell start__card">
        <div>
          <p class="eyebrow eyebrow--light">Start the conversation</p>
          <h2>Tell us how you would like to help.</h2>
          <p>
            Email the team with your name, city, availability and the kind of work that interests you. MYL Canada will reply with current opportunities when available.
          </p>
        </div>
        <div class="start__actions">
          <a class="button button--light" href={volunteerEmail}>Email the volunteer team</a>
          <a class="button button--ghost" href="https://www.instagram.com/mylcanada/" target="_blank" rel="noreferrer">Message @mylcanada ↗</a>
          <small>No personal information is collected by this website. These links open your email app or the official Instagram profile.</small>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .invitation__inner {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
  }

  .invitation h2 {
    max-width: 18ch;
    margin-top: 0.75rem;
  }

  /* Open-concept fields: no card, no boxes — just ruled lines. */

  .invitation__form {
    gap: clamp(1.5rem, 3vw, 2.25rem);
  }

  .invitation__row--three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .invitation__form .field input,
  .invitation__form .field select,
  .invitation__form .field textarea {
    min-height: 2.75rem;
    padding: 0.55rem 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
  }

  .invitation__form .field textarea {
    min-height: 4.5rem;
  }

  .invitation__form .field input:focus-visible,
  .invitation__form .field select:focus-visible,
  .invitation__form .field textarea:focus-visible {
    border-bottom-color: var(--green);
    box-shadow: 0 1px 0 0 var(--green);
    outline: none;
  }

  .invitation__form .field :is(input, select, textarea)[aria-invalid="true"] {
    border-bottom-color: var(--red);
  }

  .invitation__form .site-form__actions {
    margin-top: 0.5rem;
  }

  @media (max-width: 700px) {
    .invitation__row--three {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .roles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .roles article {
    min-height: 320px;
    padding: 1.5rem;
    border: 1px solid var(--cream-deep);
    border-radius: var(--radius);
    background: var(--white);
  }

  .roles article > span {
    color: var(--red);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .roles h3 {
    margin-top: 4.5rem;
  }

  .roles article p {
    margin-top: 0.8rem;
    color: var(--muted);
  }

  .expectations__grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .expectations figure {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 680px;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--green-deep);
  }

  .expectations figure::before {
    content: "";
    position: absolute;
    width: 430px;
    aspect-ratio: 1;
    bottom: 5rem;
    border: 3.2rem solid var(--red);
    border-radius: 50%;
  }

  .expectations figure :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    min-height: 680px;
    object-fit: contain;
    object-position: bottom;
  }

  .expectations h2 {
    margin-top: 1rem;
  }

  .expectations ol {
    padding: 0;
    margin-top: 2rem;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .expectations li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .expectations li > span {
    color: var(--red);
    font-size: 0.72rem;
    font-weight: 800;
  }

  .expectations li p {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .team-photo {
    position: relative;
    min-height: min(72vw, 760px);
    overflow: hidden;
    background: var(--green-deep);
  }

  .team-photo :global(img) {
    width: 100%;
    height: 100%;
    min-height: min(72vw, 760px);
    object-fit: cover;
  }

  .team-photo__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(2rem, 7vw, 5rem);
    background: linear-gradient(0deg, rgb(12 44 30 / 0.9), transparent 55%);
    color: var(--white);
  }

  .team-photo h2 {
    max-width: 13ch;
    margin-top: 1rem;
  }

  .start__card {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 7vw, 7rem);
    padding: clamp(2rem, 6vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--red);
    color: var(--white);
  }

  .start h2 {
    margin-top: 1rem;
  }

  .start__card > div:first-child > p:not(.eyebrow) {
    margin-top: 1.2rem;
    color: rgb(255 255 255 / 0.78);
  }

  .start__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .start__actions small {
    max-width: 48ch;
    color: rgb(255 255 255 / 0.62);
  }

  @media (max-width: 850px) {
    .expectations__grid,
    .start__card {
      grid-template-columns: 1fr;
    }

    .roles__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .roles__grid {
      grid-template-columns: 1fr;
    }

    .roles article {
      min-height: 250px;
    }

    .expectations figure,
    .expectations figure :global(img) {
      min-height: 520px;
    }
  }
</style>

<script>
  import "../scripts/site-form.ts";
</script>
