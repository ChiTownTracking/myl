---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import hoodieImage from "../assets/images/herosection/myl-back-hoodies.png";
---

<Layout title="Page not found" description="The page you requested could not be found.">
  <main id="main" class="not-found">
    <div class="shell not-found__grid">
      <div>
        <p class="eyebrow eyebrow--light">404 · Page not found</p>
        <h1>This path ends here. The journey does not.</h1>
        <p>Try the homepage, explore our programs or find the latest MYL Canada events.</p>
        <div class="button-row">
          <a class="button button--light" href="/">Return home</a>
          <a class="button button--ghost" href="/events/">Browse events</a>
        </div>
      </div>
      <div class="not-found__image" aria-hidden="true">
        <Image src={hoodieImage} alt="" widths={[480, 760, 1051]} sizes="(max-width: 760px) 76vw, 38vw" format="webp" />
      </div>
    </div>
  </main>
</Layout>

<style>
  .not-found {
    overflow: hidden;
    background: var(--green-deep);
    color: var(--white);
  }

  .not-found__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 2rem;
    min-height: 760px;
  }

  .not-found h1 {
    max-width: 10ch;
    margin-top: 1rem;
    font-size: clamp(3rem, 7vw, 6.5rem);
  }

  .not-found__grid > div:first-child > p:not(.eyebrow) {
    max-width: 52ch;
    margin-top: 1.4rem;
    color: rgb(255 255 255 / 0.72);
  }

  .not-found__image {
    position: relative;
    align-self: stretch;
  }

  .not-found__image::before {
    content: "";
    position: absolute;
    width: 420px;
    aspect-ratio: 1;
    left: 50%;
    bottom: 6rem;
    border: 3rem solid var(--red);
    border-radius: 50%;
    transform: translateX(-50%);
  }

  .not-found__image :global(img) {
    position: absolute;
    z-index: 1;
    width: 100%;
    height: 100%;
    inset: auto 0 0;
    object-fit: contain;
    object-position: bottom;
  }

  @media (max-width: 760px) {
    .not-found__grid {
      grid-template-columns: 1fr;
      padding-top: 5rem;
    }

    .not-found__image {
      min-height: 480px;
    }
  }
</style>
