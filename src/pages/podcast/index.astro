---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import podcastLogo from "../../assets/images/podcast/tomorrows-ummah-podcast-logo.jpeg";
import ghazaliThumbnail from "../../assets/images/podcast/imam-al-ghazali.jpg";
import extremismThumbnail from "../../assets/images/podcast/confronting-extremism.jpg";
import dawahThumbnail from "../../assets/images/podcast/reviving-dawah.jpg";
import charityThumbnail from "../../assets/images/podcast/hearts-that-give.jpg";
import abuHanifaThumbnail from "../../assets/images/podcast/imam-abu-hanifa.jpg";
import madhabsThumbnail from "../../assets/images/podcast/four-madhabs.jpg";
import abdullahSheikhPortrait from "../../assets/images/podcast/team/abdullah-sheikh.png";
import aliAhmedMalikPortrait from "../../assets/images/podcast/team/ali-ahmed-malik.jpg";
import abdullahAlQadriPortrait from "../../assets/images/podcast/team/dr-abdullah-al-qadri.jpg";
import talhaMustafaviPortrait from "../../assets/images/podcast/team/talha-mustafavi.png";
import abdulQadirPortrait from "../../assets/images/podcast/team/abdul-qadir.png";
import "../../styles/podcast.css";

const channelUrl = "https://www.youtube.com/@tomorrowsummah";

const episodes = [
  {
    number: "10",
    title: "Confronting Extremism in Belief, Action, and Identity",
    description: "A clear-eyed conversation about recognizing extremism and recovering a balanced expression of faith, conduct, and Muslim identity.",
    href: "https://www.youtube.com/watch?v=CJyOfplAvPo",
    image: extremismThumbnail,
    alt: "Tomorrow's Ummah episode artwork for Confronting Extremism",
    date: "29 July 2025",
    datetime: "2025-07-29",
    runtime: "55 min",
  },
  {
    number: "09",
    title: "Reviving the Art of Dawah: Inviting Others to Islam",
    description: "An exploration of thoughtful invitation, good character, and communicating Islam with wisdom and care.",
    href: "https://www.youtube.com/watch?v=ALbt5JuZNno",
    image: dawahThumbnail,
    alt: "Tomorrow's Ummah episode artwork about reviving the art of dawah",
    date: "5 May 2025",
    datetime: "2025-05-05",
    runtime: "42 min",
  },
  {
    number: "08",
    title: "Hearts That Give: Charity in Islam",
    description: "A reflection on generosity, service, and how charitable action connects belief to the needs of others.",
    guest: "With Awais Anwar",
    href: "https://www.youtube.com/watch?v=b5fbQ9nco5A",
    image: charityThumbnail,
    alt: "Tomorrow's Ummah episode artwork for Hearts That Give",
    date: "13 April 2025",
    datetime: "2025-04-13",
    runtime: "48 min",
  },
  {
    number: "07",
    title: "Imam Abu Hanifa: The Guiding Light of Islamic Scholarship",
    description: "A journey through the life, scholarship, and enduring influence of Imam Abu Hanifa.",
    href: "https://www.youtube.com/watch?v=1mnG5l-q1rU",
    image: abuHanifaThumbnail,
    alt: "Tomorrow's Ummah episode artwork about Imam Abu Hanifa",
    date: "10 March 2025",
    datetime: "2025-03-10",
    runtime: "52 min",
  },
  {
    number: "06",
    title: "The Four Madhabs: One Faith, Four Pathways",
    description: "An introduction to the four Sunni schools of law and the scholarly diversity held within a shared faith.",
    href: "https://www.youtube.com/watch?v=thtcO4MzIB8",
    image: madhabsThumbnail,
    alt: "Tomorrow's Ummah episode artwork about the four madhabs",
    date: "28 November 2024",
    datetime: "2024-11-28",
    runtime: "1 hr 8 min",
  },
  {
    number: "05",
    title: "Imam Al-Ghazali: The Proof of Islam",
    description: "Al-Ghazali's search for truth, spiritual transformation, and lasting synthesis of reason, theology, and inner life.",
    guest: "With Dr. Abdullah Al-Qadri and Brother Zaed",
    href: "https://www.youtube.com/watch?v=FAGG-mqpbqI",
    image: ghazaliThumbnail,
    alt: "Tomorrow's Ummah episode artwork for Imam Al-Ghazali: The Proof of Islam",
    date: "28 October 2024",
    datetime: "2024-10-28",
    runtime: "1 hr 11 min",
  },
];

const latestEpisode = episodes[0];
const popularEpisode = episodes.find((episode) => episode.number === "05") ?? episodes[5];
const archiveEpisodes = episodes.slice(1);

const team = [
  {
    initials: "AQ",
    name: "Abdul Qadir",
    role: "Podcast Production Lead",
    image: abdulQadirPortrait,
    alt: "Portrait of Abdul Qadir",
  },
  {
    initials: "TM",
    name: "Talha Mustafavi",
    role: "Logistics Support",
    image: talhaMustafaviPortrait,
    alt: "Portrait of Talha Mustafavi",
  },
  {
    initials: "AM",
    name: "Ali Ahmed Malik",
    role: "Host",
    image: aliAhmedMalikPortrait,
    alt: "Portrait of Ali Ahmed Malik",
  },
  {
    initials: "AS",
    name: "Abdullah Sheikh",
    role: "Host",
    image: abdullahSheikhPortrait,
    alt: "Portrait of Abdullah Sheikh",
  },
  {
    initials: "AQ",
    name: "Dr. Abdullah Al-Qadri",
    role: "Guest",
    image: abdullahAlQadriPortrait,
    alt: "Portrait of Dr. Abdullah Al-Qadri",
  },
];
---

<Layout
  title="Tomorrow's Ummah Podcast"
  description="Tomorrow's Ummah brings Islamic history, scholarship, faith, and identity into thoughtful conversation for the world Muslims are building next."
  image={podcastLogo}
  themeColor="#2d2d2d"
>
  <div class="podcast-page" id="top">
    <a class="podcast-skip-link" href="#main">Skip to main content</a>

    <main id="main">
      <section class="podcast-hero" aria-labelledby="podcast-title">
        <div class="podcast-hero__geometry" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        <div class="podcast-shell podcast-hero__grid">
          <div class="podcast-hero__copy">
            <p class="podcast-kicker">An MYL Canada original</p>
            <h1 id="podcast-title">Ideas that shape <em>tomorrow.</em></h1>
          </div>

          <div class="podcast-hero__art" aria-label="Tomorrow's Ummah Podcast artwork">
            <div class="podcast-hero__art-frame">
              <Image src={podcastLogo} alt="Tomorrow's Ummah Podcast" widths={[600, 900, 1200]} sizes="(max-width: 900px) min(88vw, 34rem), 42vw" format="webp" quality={92} loading="eager" fetchpriority="high" />
              <span class="podcast-hero__art-index" aria-hidden="true">TU / 01</span>
            </div>
            <a class="now-playing" href={latestEpisode.href} target="_blank" rel="noopener noreferrer">
              <span class="now-playing__icon" aria-hidden="true">▶</span>
              <span><small>Latest release · Episode {latestEpisode.number}</small><strong>{latestEpisode.title}</strong></span>
              <span class="now-playing__bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            </a>
          </div>

          <p class="podcast-hero__intro">
            Tomorrow's Ummah is where the depth of Islamic tradition meets the questions shaping Muslim life now—through thoughtful, open, and relevant conversation.
          </p>

          <div class="podcast-actions">
            <a class="podcast-button" href={latestEpisode.href} target="_blank" rel="noopener noreferrer"><svg class="podcast-button__youtube" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.58 7.19a2.95 2.95 0 0 0-2.08-2.08C17.66 4.6 12 4.6 12 4.6s-5.66 0-7.5.51a2.95 2.95 0 0 0-2.08 2.08A30.4 30.4 0 0 0 1.9 12a30.4 30.4 0 0 0 .52 4.81 2.95 2.95 0 0 0 2.08 2.08c1.84.51 7.5.51 7.5.51s5.66 0 7.5-.51a2.95 2.95 0 0 0 2.08-2.08A30.4 30.4 0 0 0 22.1 12a30.4 30.4 0 0 0-.52-4.81ZM10 15.2V8.8l5.5 3.2Z"></path></svg>Listen to latest episode</a>
            <a class="podcast-button podcast-button--outline" href="#episodes">Browse episodes</a>
          </div>

        </div>
      </section>

      <section class="popular" aria-labelledby="popular-title">
        <div class="podcast-shell popular__heading"><p class="podcast-kicker podcast-kicker--dark">Listener favourite</p><span>Popular episode</span></div>
        <article class="podcast-shell popular__feature">
          <a class="popular__media" href={popularEpisode.href} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${popularEpisode.title} on YouTube`}>
            <Image src={popularEpisode.image} alt={popularEpisode.alt} widths={[720, 1080, 1440]} sizes="(max-width: 900px) calc(100vw - 2.25rem), 57vw" format="webp" quality={90} />
            <span class="popular__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="31" height="31"><path d="m9 7 8 5-8 5Z"></path></svg></span>
          </a>
          <div class="popular__copy">
            <div class="episode-meta"><span>Episode {popularEpisode.number}</span><time datetime={popularEpisode.datetime}>{popularEpisode.date}</time><span>{popularEpisode.runtime}</span></div>
            <h2 id="popular-title">{popularEpisode.title}</h2>
            <p>{popularEpisode.description}</p>
            <div class="popular__actions">
              <a class="podcast-button podcast-button--dark" href={popularEpisode.href} target="_blank" rel="noopener noreferrer">Watch episode <span aria-hidden="true">↗</span></a>
              <a class="podcast-text-link" href="#episodes">Explore the archive <span aria-hidden="true">↓</span></a>
            </div>
          </div>
        </article>
      </section>

      <section class="episodes" id="episodes" aria-labelledby="episodes-title">
        <div class="podcast-shell">
          <div class="section-heading section-heading--light">
            <div><p class="podcast-kicker">The archive</p><h2 id="episodes-title">Listen deeper.</h2></div>
            <p>History, belief, service, and identity—explored with the time and care each question deserves.</p>
          </div>
          <div class="episodes__list">
            {archiveEpisodes.map((episode) => (
              <article class="episode-row">
                <div class="episode-row__number" aria-label={`Episode ${episode.number}`}><small>EP</small><strong>{episode.number}</strong></div>
                <a class="episode-row__media" href={episode.href} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${episode.title} on YouTube`}>
                  <Image src={episode.image} alt={episode.alt} widths={[400, 640, 800]} sizes="(max-width: 720px) calc(100vw - 2.25rem), 23vw" format="webp" quality={87} />
                  <span aria-hidden="true">▶</span>
                </a>
                <div class="episode-row__copy">
                  <div class="episode-meta episode-meta--light"><time datetime={episode.datetime}>{episode.date}</time><span>{episode.runtime}</span></div>
                  <h3><a href={episode.href} target="_blank" rel="noopener noreferrer">{episode.title}</a></h3>
                  {episode.guest && <p class="episode-row__guest">{episode.guest}</p>}
                  <p>{episode.description}</p>
                </div>
                <a class="episode-row__action" href={episode.href} target="_blank" rel="noopener noreferrer"><span>Watch</span><span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
          <div class="episodes__footer"><a class="podcast-button" href={channelUrl} target="_blank" rel="noopener noreferrer">View all episodes on YouTube <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section class="podcast-about" id="about" aria-labelledby="about-title">
        <div class="podcast-about__shape" aria-hidden="true"></div>
        <div class="podcast-shell podcast-about__grid">
          <div><p class="podcast-kicker podcast-kicker--dark">Why Tomorrow's Ummah</p><h2 id="about-title">Old wisdom.<br />Honest questions.<br /><em>A living tradition.</em></h2></div>
          <div class="podcast-about__copy">
            <p class="podcast-about__lead">Tomorrow's Ummah opens accessible conversations about the people, ideas, and choices that have shaped Muslim life—and what they can teach us about living faithfully today.</p>
            <p>Episodes move between intellectual history and urgent contemporary questions without losing sight of character, service, and community.</p>
            <ul aria-label="Topics explored on Tomorrow's Ummah">
              <li><span>01</span> Islamic history</li><li><span>02</span> Faith & identity</li><li><span>03</span> Scholarship</li><li><span>04</span> Service & society</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="podcast-team" id="team" aria-labelledby="team-title">
        <div class="podcast-shell">
          <div class="section-heading">
            <div><p class="podcast-kicker podcast-kicker--dark">Behind the podcast</p><h2 id="team-title">The team behind every conversation.</h2></div>
            <p>From production and logistics to the voices at the microphone, meet the people who make Tomorrow's Ummah possible.</p>
          </div>
          <div class="team__grid">
            {team.map((member, index) => (
              <article class:list={["team-card", !member.image && "team-card--placeholder"]}>
                <div class="team-card__portrait">
                  {member.image ? (
                    <Image
                      src={member.image}
                      alt={member.alt}
                      widths={[360, 560, 760]}
                      sizes="(max-width: 720px) calc(100vw - 2.25rem), (max-width: 1080px) 30vw, 18vw"
                      format="webp"
                      quality={88}
                    />
                  ) : (
                    <div class="team-card__placeholder" role="img" aria-label={`Portrait of ${member.name} coming soon`}>
                      <span aria-hidden="true">{member.initials}</span>
                      <small>Portrait coming soon</small>
                    </div>
                  )}
                  <span class="team-card__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                </div>
                <div class="team-card__body">
                  <p>{member.role}</p>
                  <h3>{member.name}</h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="listen-cta" aria-labelledby="listen-title">
        <div class="listen-cta__petals" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="podcast-shell listen-cta__inner">
          <div><p class="podcast-kicker">Stay with the conversation</p><h2 id="listen-title">The next idea is waiting.</h2><p>Subscribe to Tomorrow's Ummah on YouTube and be there when a new episode arrives.</p></div>
          <a class="podcast-button podcast-button--light" href={channelUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M21.58 7.19a2.95 2.95 0 0 0-2.08-2.08C17.66 4.6 12 4.6 12 4.6s-5.66 0-7.5.51a2.95 2.95 0 0 0-2.08 2.08A30.4 30.4 0 0 0 1.9 12a30.4 30.4 0 0 0 .52 4.81 2.95 2.95 0 0 0 2.08 2.08c1.84.51 7.5.51 7.5.51s5.66 0 7.5-.51a2.95 2.95 0 0 0 2.08-2.08A30.4 30.4 0 0 0 22.1 12a30.4 30.4 0 0 0-.52-4.81ZM10 15.2V8.8l5.5 3.2Z"></path></svg>
            Subscribe on YouTube
          </a>
        </div>
      </section>
    </main>

  </div>
</Layout>
