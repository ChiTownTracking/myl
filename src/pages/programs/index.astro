---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import SectionIntro from "../../components/SectionIntro.astro";
import ExperienceCard from "../../components/ExperienceCard.astro";
import mercyImage from "../../assets/images/al-rahma-conference/shaykh-hammad-facing-crowd.png";
import hoopsTeam from "../../assets/images/hoops4humanity/myl-basketball.png";
import hoopsAction from "../../assets/images/hoops4humanity/basketball-1.png";
import qaImage from "../../assets/images/myl-qa-2026/myl-qa-2026-community.jpg";
import hoodieImage from "../../assets/images/herosection/myl-back-hoodies.png";
import hidayahImage from "../../assets/images/al-hidayah/al-hidayah-2026-keynote.jpg";
import renaissanceCover from "../../assets/images/renaissance/summer-2025.png";

const mylPrograms = [
  {
    eyebrow: "Annual conference",
    title: "Al-Rahma (Mercy for Humanity)",
    description:
      "MYL Canada’s flagship conference series exploring the Prophetic example of mercy, dignity and justice.",
    href: "/events/mercy-for-humanity/",
    linkLabel: "Explore the series",
    image: mercyImage,
    imageAlt: "A scholar addressing the Al-Rahma conference audience",
  },
  {
    eyebrow: "Sport & fellowship",
    title: "Hoops 4 Humanity",
    description:
      "Basketball that brings youth together around teamwork, community and a service-minded purpose.",
    href: "/programs/hoops-for-humanity/",
    linkLabel: "Take it to the court",
    image: hoopsAction,
    imageAlt: "A player shooting the basketball during a MYL community game",
  },
  {
    eyebrow: "Islamic learning",
    title: "Al-Hikmah & youth conversations",
    description:
      "Halaqahs, tafsir, scholar Q&As and candid conversations about identity, purpose and contemporary life.",
    href: "/events/",
    linkLabel: "See recent gatherings",
    image: qaImage,
    imageAlt: "A MYL Canada youth question-and-answer gathering",
  },
  {
    eyebrow: "Spiritual & social life",
    title: "Gather. Remember. Serve.",
    description:
      "Mawlid programs, youth i‘tikaf, remembrance, community drives and the everyday work of belonging.",
    href: "/get-involved/",
    linkLabel: "Get involved",
    image: hoodieImage,
    imageAlt: "Two young people wearing Muslim Youth League Canada hoodies",
  },
];
---

<Layout
  title="Programs"
  description="Explore MYL Canada programs in Islamic learning, spiritual development, service, sport and youth leadership."
  image={hoopsTeam}
>
  <main id="main">
    <PageHero
      eyebrow="Programs"
      title="Faith grows when it moves through life."
      intro="MYL Canada programming joins serious learning with spiritual formation, friendship, service and recreation—because young people need a community that sees the whole person."
      image={hoopsTeam}
      imageAlt="Players, volunteers and families at a MYL Canada basketball gathering"
      tone="dark"
      meta={[
        { label: "Learn", value: "Halaqahs & Q&As" },
        { label: "Gather", value: "Conferences & retreats" },
        { label: "Act", value: "Service & sport" },
      ]}
    />

    <section class="section programs">
      <div class="shell">
        <SectionIntro
          eyebrow="MYL-led programming"
          title="Many ways to grow."
          intro="Some young people enter through a lecture, others through a team, a volunteer shift or a difficult question. Each is a valid beginning."
        />
        <div class="programs__grid">
          {mylPrograms.map((program) => <ExperienceCard {...program} />)}
        </div>
      </div>
    </section>

    <section class="section section--cream pathway">
      <div class="shell pathway__grid">
        <div>
          <p class="eyebrow">The MYL pathway</p>
          <h2>Come as you are. Leave ready to contribute.</h2>
        </div>
        <ol>
          <li><span>01</span><div><h3>Attend</h3><p>Start with an event, learning circle, game or gathering.</p></div></li>
          <li><span>02</span><div><h3>Connect</h3><p>Meet people who are asking, learning and building alongside you.</p></div></li>
          <li><span>03</span><div><h3>Volunteer</h3><p>Join a team and learn through real responsibility.</p></div></li>
          <li><span>04</span><div><h3>Lead</h3><p>Help shape the next program, conversation or act of service.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="section connections">
      <div class="shell">
        <SectionIntro
          eyebrow="Connected initiatives"
          title="Partnership without blurred lines."
          intro="MYL Canada also contributes to or points young people toward strong initiatives in its wider scholarly and community ecosystem."
        />
        <div class="connections__grid">
          <article class="connection-card">
            <div class="connection-card__media">
              <Image
                src={hidayahImage}
                alt="Shaykh-ul-Islam teaching at Al-Hidayah Canada 2026"
                widths={[480, 780]}
                sizes="(max-width: 760px) 92vw, 24vw"
                format="webp"
              />
            </div>
            <div class="connection-card__copy">
              <p class="eyebrow">Volunteer-supported</p>
              <h3>Al-Hidayah Canada</h3>
              <p>
                A three-day residential spiritual and educational retreat organized by MQI Canada.
                MYL Canada volunteers supported registration and event delivery.
              </p>
              <a class="text-link" href="/events/al-hidayah/">Understand the retreat</a>
            </div>
          </article>
          <article class="connection-card connection-card--dark">
            <div class="connection-card__media connection-card__media--cover">
              <Image
                src={renaissanceCover}
                alt="Summer 2025 Al-Andalus issue of Renaissance"
                widths={[380, 620]}
                sizes="(max-width: 760px) 72vw, 22vw"
                format="webp"
              />
            </div>
            <div class="connection-card__copy">
              <p class="eyebrow eyebrow--light">Related resource</p>
              <h3>Renaissance · Al-Nahda</h3>
              <p>
                A journal founded by recurring MYL keynote speaker Shaykh Hammad Mustafa al-Madani
                al-Qadri. It is featured here as a related intellectual resource, not as an MYL-owned publication.
              </p>
              <a class="text-link connection-card__link" href="/renaissance/">Explore Renaissance</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--compact">
      <div class="shell cta-band">
        <p class="eyebrow eyebrow--light">Ready to take part?</p>
        <h2>Follow the work. Then help shape it.</h2>
        <p>Current registrations and local updates are shared through MYL Canada’s social channels.</p>
        <div class="button-row">
          <a class="button button--light" href="https://www.instagram.com/mylcanada/" target="_blank" rel="noreferrer">Follow @mylcanada ↗</a>
          <a class="button button--ghost" href="/get-involved/">Volunteer with MYL</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .programs__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 3rem;
  }

  .pathway__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .pathway h2 {
    max-width: 12ch;
    margin-top: 1rem;
  }

  .pathway ol {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--cream-deep);
  }

  .pathway li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 1.2rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--cream-deep);
  }

  .pathway li > span {
    color: var(--red);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .pathway li p {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .connections__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
  }

  .connection-card {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    overflow: hidden;
    min-height: 540px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--white);
  }

  .connection-card--dark {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--white);
  }

  .connection-card__media {
    min-height: 100%;
    overflow: hidden;
    background: var(--green-deep);
  }

  .connection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .connection-card__media--cover {
    padding: 2rem;
    background: #0d110e;
  }

  .connection-card__media--cover img {
    object-fit: contain;
    filter: drop-shadow(0 20px 28px rgb(0 0 0 / 0.4));
  }

  .connection-card__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .connection-card h3 {
    margin-top: 0.9rem;
  }

  .connection-card__copy > p:not(.eyebrow) {
    margin: 1rem 0 1.5rem;
    color: var(--muted);
  }

  .connection-card--dark .connection-card__copy > p:not(.eyebrow) {
    color: rgb(255 255 255 / 0.7);
  }

  .connection-card__link {
    color: #ff9aa8;
  }

  .cta-band > p:not(.eyebrow) {
    max-width: 54ch;
    margin-top: 1.2rem;
    color: rgb(255 255 255 / 0.78);
  }

  .cta-band h2 {
    margin-top: 1rem;
  }

  @media (max-width: 960px) {
    .connections__grid,
    .pathway__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .programs__grid,
    .connections__grid,
    .connection-card {
      grid-template-columns: 1fr;
    }

    .connection-card__media {
      min-height: 320px;
    }
  }
</style>
