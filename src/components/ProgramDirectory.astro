---
import { Image } from "astro:assets";
import { programs } from "../data/activities";

const categories = ["All programs", ...new Set(programs.map((program) => program.category))];
---

<program-directory>
  <div class="directory__toolbar" hidden>
    <div class="directory__filters" role="group" aria-label="Filter programs by category">
      {categories.map((category, index) => (
        <button type="button" data-category={category} aria-pressed={index === 0} aria-controls="program-results">
          {category}
        </button>
      ))}
    </div>
    <p class="directory__count" role="status" aria-live="polite" aria-atomic="true">{programs.length} programs</p>
  </div>
  <div class="directory__grid" id="program-results">
    {programs.map((program) => (
      <article class="program-card" data-category={program.category} id={program.id}>
        <div class:list={["program-card__media", program.imageStyle && `program-card__media--${program.imageStyle}`, { "program-card__media--hikmah": program.id === "al-hikmah" }]}>
          <Image src={program.image} alt={program.imageAlt}
            widths={program.imageStyle === "logo" ? [program.image.width] : [360, 640, 880]}
            sizes={program.imageStyle === "logo" ? "150px" : "(max-width: 620px) 92vw, (max-width: 1000px) 46vw, 390px"}
            format="webp" loading="lazy" decoding="async" />
          {program.imageCaption && <span class="program-card__caption">{program.imageCaption}</span>}
        </div>
        <div class="program-card__body">
          <p class="program-card__category">{program.category}</p>
          <h3>{program.title}</h3>
          <p class="program-card__description">{program.description}</p>
          <p class="program-card__meta">{program.meta}</p>
          <div class="program-card__links">
            <a class="program-card__primary" href={program.href}
              target={program.href.startsWith("https://") ? "_blank" : undefined}
              rel={program.href.startsWith("https://") ? "noopener noreferrer" : undefined}>
              {program.linkLabel}<span aria-hidden="true">{program.href.startsWith("https://") ? "↗" : "→"}</span>
            </a>
            {program.source.href !== program.href && (
              <a class="program-card__source" href={program.source.href} target="_blank" rel="noopener noreferrer">
                {program.source.label}<span aria-hidden="true"> ↗</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</program-directory>

<script>
  class ProgramDirectory extends HTMLElement {
    connectedCallback() {
      const toolbar = this.querySelector<HTMLElement>(".directory__toolbar");
      const count = this.querySelector<HTMLElement>(".directory__count");
      const buttons = this.querySelectorAll<HTMLButtonElement>("button[data-category]");
      const cards = this.querySelectorAll<HTMLElement>(".program-card");
      if (!toolbar || !count) return;
      toolbar.hidden = false;
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const category = button.dataset.category;
          let visible = 0;
          cards.forEach((card) => {
            card.hidden = category !== "All programs" && card.dataset.category !== category;
            if (!card.hidden) visible++;
          });
          buttons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
          count.textContent = `${visible} ${visible === 1 ? "program" : "programs"}${category === "All programs" ? "" : ` · ${category}`}`;
        });
      });
    }
  }
  if (!customElements.get("program-directory")) customElements.define("program-directory", ProgramDirectory);
</script>

<style>
  program-directory { display: block; margin-top: 2.5rem; }
  .directory__toolbar { margin-bottom: 2rem; }
  .directory__toolbar[hidden], .program-card[hidden] { display: none; }
  .directory__filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .directory__filters button { padding: 0.7rem 1.05rem; border: 1px solid var(--line); border-radius: 99px; background: transparent; color: var(--ink); font-size: 0.8rem; font-weight: 700; transition: background 180ms ease, color 180ms ease; }
  .directory__filters button:hover { background: var(--green-soft); }
  .directory__filters button[aria-pressed="true"] { border-color: var(--green-deep); background: var(--green-deep); color: var(--white); }
  .directory__count { margin-top: 0.9rem; color: var(--muted); font-size: 0.8rem; }
  .directory__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.4rem; }
  .program-card { display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); scroll-margin-top: 8rem; }
  .program-card__media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--cream); border-bottom: 1px solid var(--line); }
  .program-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .program-card__media--poster { padding: 0.8rem; background: #eee6d9; }
  .program-card__media--poster :global(img) { object-fit: contain; }
  .program-card__media--logo { display: grid; place-items: center; background: #fff; }
  .program-card__media--logo :global(img) { width: 150px; height: 150px; object-fit: contain; }
  .program-card__media--hikmah { background: #891b1d; }
  .program-card__caption { position: absolute; bottom: 0.7rem; left: 0.7rem; padding: 0.25rem 0.55rem; border-radius: 0.3rem; background: rgb(0 0 0 / 0.7); color: white; font-size: 0.65rem; }
  .program-card__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: clamp(1.2rem, 2.3vw, 1.7rem); }
  .program-card__category { color: var(--red-deep); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; }
  h3 { margin-top: 0.65rem; font-family: var(--font-serif); font-size: clamp(1.5rem, 2vw, 1.85rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
  .program-card__description { margin-top: 0.85rem; color: var(--muted); font-size: 0.92rem; }
  .program-card__meta { margin-top: 1.1rem; padding-bottom: 1.3rem; color: var(--green-deep); font-size: 0.74rem; font-weight: 700; }
  .program-card__links { display: flex; flex-direction: column; align-items: flex-start; gap: 0.65rem; width: 100%; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--line); }
  .program-card__primary { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--green-deep); font-size: 0.82rem; font-weight: 800; }
  .program-card__source { color: var(--muted); font-size: 0.72rem; }
  .program-card__links a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 1000px) { .directory__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .directory__grid { grid-template-columns: minmax(0, 1fr); }
    .directory__filters button { padding: 0.65rem 0.85rem; font-size: 0.74rem; }
  }
  @media (prefers-reduced-motion: reduce) { .directory__filters button { transition: none; } }
</style>
