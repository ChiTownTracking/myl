---
import Logo from "./Logo.astro";
import { navigation, organization, socialLinks, sourceLinks } from "../data/site.js";

const year = new Date().getFullYear();

const coreLinks = [
  { label: "Home", href: "/" },
  ...navigation,
  { label: "Gallery", href: "/gallery/" },
  { label: "Get involved", href: "/get-involved/" },
  { label: "Contact", href: "/contact/" },
];

const programLinks = [
  { label: "Hoops 4 Humanity", href: "/programs/hoops-for-humanity/" },
];

const relatedSites = [
  { label: "Al-Hidayah", detail: "Official camp website", href: sourceLinks.alHidayah },
  { label: "Al-Nahda", detail: "Official journal website", href: sourceLinks.renaissance },
];

const socialIcons: Record<string, string> = {
  Instagram:
    "M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c0 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2 0-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c0-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.2a6.6 6.6 0 100 13.2 6.6 6.6 0 000-13.2zm0 10.9a4.3 4.3 0 110-8.6 4.3 4.3 0 010 8.6zm8.4-11.2a1.55 1.55 0 11-3.1 0 1.55 1.55 0 013.1 0z",
  Facebook:
    "M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.9 3.77-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0022 12z",
  LinkedIn:
    "M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V8.98h3.42v1.57h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.29zM5.32 7.41a2.07 2.07 0 110-4.13 2.07 2.07 0 010 4.13zM7.1 20.45H3.54V8.98H7.1v11.47z",
  YouTube:
    "M21.6 7.2a2.5 2.5 0 00-1.77-1.77C18.25 5 12 5 12 5s-6.25 0-7.83.43A2.5 2.5 0 002.4 7.2C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 001.77 1.77C5.75 19 12 19 12 19s6.25 0 7.83-.43A2.5 2.5 0 0021.6 16.8C22 15.2 22 12 22 12s0-3.2-.4-4.8zM10 15.2V8.8l5.2 3.2-5.2 3.2z",
};
---

<footer class="site-footer">
  <div class="footer__accent" aria-hidden="true"></div>

  <div class="footer__main shell">
    <div class="footer__identity">
      <a class="footer__brand" href="/" aria-label={`${organization.shortName} home`}>
        <Logo size={72} tone="light" />
      </a>
      <p class="footer__intro">
        Bringing young Muslims together through faith-centred learning, service, sport and
        meaningful community life.
      </p>

      <address class="footer__contact">
        <div>
          <span>Email</span>
          <a href={`mailto:${organization.email}`}>{organization.email}</a>
        </div>
        <div>
          <span>Phone</span>
          <a href={`tel:${organization.phoneHref}`}>{organization.phone}</a>
        </div>
        <div>
          <span>Visit</span>
          <a
            href={organization.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${organization.address} (opens in a new tab)`}
          >
            {organization.address}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </address>
    </div>

    <nav class="footer__nav" aria-label="Footer navigation">
      <div>
        <h2>Explore</h2>
        <ul class="footer__route-list">
          {
            coreLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2>Program spotlight</h2>
        <ul class="footer__program-list">
          {
            programLinks.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>

        <h2 class="footer__related-heading">Related sites</h2>
        <ul class="footer__related-list">
          {
            relatedSites.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.label}, ${item.detail} (opens in a new tab)`}
                >
                  <span>
                    <strong>{item.label}</strong>
                    <small>{item.detail}</small>
                  </span>
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer__social shell">
    <p>Follow MYL Canada</p>
    <ul aria-label="Social media">
      {
        socialLinks.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${social.label}: ${social.handle} (opens in a new tab)`}
            >
              <span class="footer__social-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="17" height="17">
                  <path d={socialIcons[social.label]} />
                </svg>
              </span>
              <span>
                <strong>{social.label}</strong>
                <small>{social.handle}</small>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="footer__base shell">
    <div>
      <p>© {year} {organization.name}. All rights reserved.</p>
      <p class="footer__source-note">
        Historical conference details are accompanied by links to the original organizer reports
        in the <a href="/events/mercy-for-humanity/">Al-Rahma archive</a>.
      </p>
    </div>
    <a class="footer__privacy" href="/privacy/">Privacy</a>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--green-deep, #073c30);
    color: rgb(255 255 255 / 0.76);
  }

  .site-footer::before {
    position: absolute;
    z-index: -1;
    right: -8rem;
    bottom: -14rem;
    width: 34rem;
    height: 34rem;
    border: 5.5rem solid rgb(255 255 255 / 0.025);
    border-radius: 50%;
    content: "";
  }

  .footer__accent {
    height: 5px;
    background: linear-gradient(90deg, var(--red, #d63835) 0 36%, #fff 36% 38%, var(--green, #159a67) 38%);
  }

  .footer__main,
  .footer__social,
  .footer__base {
    width: min(calc(100% - (var(--gutter, 1.25rem) * 2)), var(--shell, 1240px));
    margin-inline: auto;
  }

  .footer__main {
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(420px, 1.2fr);
    gap: clamp(3rem, 8vw, 7rem);
    padding-block: clamp(3.5rem, 7vw, 6rem) clamp(2.6rem, 5vw, 4rem);
  }

  .footer__brand {
    display: inline-flex;
    border-radius: var(--radius, 0.75rem);
  }

  .footer__intro {
    max-width: 38ch;
    margin: 1.35rem 0 0;
    color: rgb(255 255 255 / 0.76);
    font-size: 0.98rem;
    line-height: 1.72;
  }

  .footer__contact {
    display: grid;
    gap: 0.85rem;
    max-width: 31rem;
    margin-top: 1.8rem;
    font-style: normal;
  }

  .footer__contact > div {
    display: grid;
    grid-template-columns: 3.6rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: baseline;
  }

  .footer__contact > div > span {
    color: rgb(255 255 255 / 0.46);
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__contact a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    width: fit-content;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.45;
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.24);
    text-underline-offset: 0.25em;
    transition: color 170ms ease, text-decoration-color 170ms ease;
  }

  .footer__contact a:hover {
    color: #bce9d3;
    text-decoration-color: currentColor;
  }

  .footer__nav {
    display: grid;
    grid-template-columns: minmax(190px, 1fr) minmax(190px, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .footer__nav h2,
  .footer__social > p {
    margin: 0 0 1rem;
    color: #fff;
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.15em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .footer__nav ul,
  .footer__social ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__route-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.48rem 1.2rem;
  }

  .footer__route-list a,
  .footer__program-list a {
    display: inline-flex;
    padding-block: 0.16rem;
    color: rgb(255 255 255 / 0.74);
    font-size: 0.88rem;
    transition: color 170ms ease, transform 170ms ease;
  }

  .footer__route-list a:hover,
  .footer__program-list a:hover {
    color: #fff;
    transform: translateX(2px);
  }

  .footer__program-list {
    display: grid;
    gap: 0.48rem;
  }

  .footer__related-heading {
    margin-top: 2rem !important;
  }

  .footer__related-list {
    display: grid;
    gap: 0.55rem;
  }

  .footer__related-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.72rem 0.78rem;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: calc(var(--radius, 0.75rem) * 0.7);
    background: rgb(255 255 255 / 0.045);
    color: #fff;
    transition: border-color 170ms ease, background 170ms ease, transform 170ms ease;
  }

  .footer__related-list a:hover {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.08);
    transform: translateY(-1px);
  }

  .footer__related-list a > span:first-child,
  .footer__social a > span:last-child {
    display: grid;
    gap: 0.18rem;
  }

  .footer__related-list strong,
  .footer__social strong {
    font-size: 0.84rem;
    line-height: 1.15;
  }

  .footer__related-list small,
  .footer__social small {
    color: rgb(255 255 255 / 0.5);
    font-size: 0.68rem;
    line-height: 1.25;
  }

  .footer__social {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: 1.55rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer__social > p {
    margin: 0;
  }

  .footer__social ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .footer__social a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #fff;
    transition: color 170ms ease;
  }

  .footer__social-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    transition: background 170ms ease, transform 170ms ease;
  }

  .footer__social-icon svg {
    fill: currentColor;
  }

  .footer__social a:hover .footer__social-icon {
    background: var(--red, #d63835);
    transform: translateY(-2px);
  }

  .footer__base {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
    color: rgb(255 255 255 / 0.54);
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .footer__base p {
    margin: 0;
  }

  .footer__source-note {
    max-width: 78ch;
    margin-top: 0.25rem !important;
  }

  .footer__source-note a,
  .footer__privacy {
    color: rgb(255 255 255 / 0.82);
    text-decoration: underline;
    text-decoration-color: rgb(255 255 255 / 0.28);
    text-underline-offset: 0.22em;
  }

  .footer__source-note a:hover,
  .footer__privacy:hover {
    color: #fff;
    text-decoration-color: currentColor;
  }

  .footer__privacy {
    flex: 0 0 auto;
  }

  @media (max-width: 920px) {
    .footer__main {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer__identity {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 2rem;
    }

    .footer__brand,
    .footer__intro {
      grid-column: 1;
    }

    .footer__contact {
      grid-column: 2;
      grid-row: 1 / span 2;
      margin-top: 0.25rem;
    }

    .footer__social {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .footer__identity,
    .footer__nav {
      grid-template-columns: 1fr;
    }

    .footer__brand,
    .footer__intro,
    .footer__contact {
      grid-column: 1;
      grid-row: auto;
    }

    .footer__contact {
      margin-top: 1.7rem;
    }

    .footer__social ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  @media (max-width: 470px) {
    .footer__route-list {
      grid-template-columns: 1fr;
    }

    .footer__social ul {
      grid-template-columns: 1fr;
    }

    .footer__base {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__contact a,
    .footer__route-list a,
    .footer__program-list a,
    .footer__related-list a,
    .footer__social a,
    .footer__social-icon {
      transition: none;
    }
  }
</style>
