---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, description, href, linkLabel, image, imageAlt = "" } = Astro.props;
---

<article class:list={["experience-card", { "experience-card--with-image": image }]}>
  {
    image && (
      <div class="experience-card__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[400, 640, 880]}
          sizes="(max-width: 680px) calc(100vw - 2.5rem), (max-width: 1080px) 50vw, 390px"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="experience-card__body">
    <p class="experience-card__eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p class="experience-card__description">{description}</p>
    <a class="text-link experience-card__link" href={href}>
      <span>{linkLabel}</span>
      <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
        <path d="M4 10h11M11 6l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .experience-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line, #e2e7e4);
    border-radius: var(--radius, 1.25rem);
    background: var(--paper, #fff);
    box-shadow: 0 0.75rem 2rem rgb(11 18 16 / 0.06);
    transition:
      border-color 220ms ease,
      box-shadow 320ms ease,
      transform 320ms ease;
  }

  .experience-card:hover {
    border-color: color-mix(in srgb, var(--green, #00815c) 40%, var(--line, #e2e7e4));
    box-shadow: var(--shadow, 0 1.4rem 3rem rgb(11 18 16 / 0.13));
    transform: translateY(-0.3rem);
  }

  .experience-card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--cream, #f5f3ed);
  }

  .experience-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    border-bottom: 3px solid var(--green, #00815c);
    background: linear-gradient(180deg, transparent 65%, rgb(0 0 0 / 0.13));
    pointer-events: none;
  }

  .experience-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .experience-card:hover .experience-card__media :global(img) {
    transform: scale(1.045);
  }

  .experience-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.35rem, 3vw, 2rem);
  }

  .experience-card__eyebrow {
    margin-bottom: 0.75rem;
    color: var(--green, #00815c);
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  h3 {
    color: var(--ink, #0b1210);
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.13;
    text-wrap: balance;
  }

  .experience-card__description {
    margin-top: 0.85rem;
    color: var(--muted, #5d6b66);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .experience-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--green-deep, #04352a);
    font-family: var(--font-sans, ui-sans-serif, system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .experience-card__link svg {
    flex: 0 0 auto;
    transition: transform 200ms ease;
  }

  .experience-card__link:hover svg {
    transform: translateX(0.25rem);
  }

  .experience-card__link:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--green, #00815c) 45%, transparent);
    outline-offset: 0.35rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .experience-card,
    .experience-card__media :global(img),
    .experience-card__link svg {
      transition: none;
    }
  }
</style>
