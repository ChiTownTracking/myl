---
export type SlimHeroTone = "green" | "red" | "dark";

export interface SlimHeroFact {
  label: string;
  value: string;
}

export interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  tone?: SlimHeroTone;
  facts?: SlimHeroFact[];
  titleId?: string;
}

const {
  eyebrow,
  title,
  intro,
  tone = "green",
  facts = [],
  titleId = "slim-hero-title",
} = Astro.props;
---

<section class:list={["slim-hero", `slim-hero--${tone}`]} aria-labelledby={titleId}>
  <div class="slim-hero__inner shell">
    <div class="slim-hero__lead">
      <div class="slim-hero__headline">
        <p class="slim-hero__eyebrow">{eyebrow}</p>
        <h1 id={titleId}>{title}</h1>
      </div>
      <p class="slim-hero__intro">{intro}</p>
    </div>

    {
      facts.length > 0 && (
        <dl class="slim-hero__facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .slim-hero {
    --slim-accent: var(--green);
    --slim-mark: var(--red);
    --slim-from: var(--green-dark);
    --slim-to: color-mix(in srgb, var(--green-deep) 88%, #050c08);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.25rem, 3.6vw, 3.1rem) clamp(1.6rem, 2.6vw, 2.25rem);
    color: var(--white);
    background:
      radial-gradient(circle at 6% 8%, color-mix(in srgb, var(--slim-accent) 45%, transparent), transparent 30rem),
      linear-gradient(118deg, var(--slim-from), var(--slim-to));
  }

  .slim-hero--red {
    --slim-accent: var(--red);
    --slim-mark: var(--cream);
    --slim-from: color-mix(in srgb, var(--red-deep) 84%, #14060a);
    --slim-to: color-mix(in srgb, var(--red-deep) 58%, #12050a);
  }

  .slim-hero--dark {
    --slim-accent: var(--green);
    --slim-mark: var(--green);
    --slim-from: var(--ink);
    --slim-to: color-mix(in srgb, var(--green-deep) 52%, #070b09);
  }

  .slim-hero::before,
  .slim-hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    border: 1px solid rgb(255 255 255 / 0.13);
    border-radius: 50%;
    pointer-events: none;
  }

  .slim-hero::before {
    inset: -78% auto auto -14%;
    width: min(34rem, 60vw);
    aspect-ratio: 1;
  }

  .slim-hero::after {
    inset: auto -8% -72% auto;
    width: min(26rem, 52vw);
    aspect-ratio: 1;
  }

  .slim-hero__lead {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: end;
    gap: clamp(1.15rem, 4.2vw, 3.75rem);
  }

  .slim-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.6rem;
    color: rgb(255 255 255 / 0.82);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .slim-hero__eyebrow::before {
    content: "";
    width: 1.7rem;
    height: 2px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--slim-mark);
  }

  .slim-hero h1 {
    max-width: 21ch;
    color: inherit;
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.3vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .slim-hero__intro {
    max-width: 44ch;
    padding-left: clamp(0rem, 1.6vw, 1.5rem);
    border-left: 1px solid rgb(255 255 255 / 0.22);
    color: rgb(255 255 255 / 0.84);
    font-size: clamp(0.92rem, 1vw, 1rem);
    line-height: 1.58;
  }

  .slim-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem clamp(1.5rem, 3.4vw, 3rem);
    margin: clamp(1.3rem, 2.4vw, 1.85rem) 0 0;
    padding-top: clamp(0.95rem, 1.7vw, 1.3rem);
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .slim-hero__facts div {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .slim-hero__facts dt {
    color: rgb(255 255 255 / 0.62);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .slim-hero__facts dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(0.94rem, 1.05vw, 1.02rem);
    line-height: 1.25;
  }

  @media (max-width: 900px) {
    .slim-hero__lead {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .slim-hero__intro {
      max-width: 56ch;
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-width: 620px) {
    .slim-hero {
      padding-block: 1.9rem 1.6rem;
    }

    .slim-hero__facts {
      gap: 0.75rem 1.5rem;
    }

    .slim-hero__facts div {
      flex-direction: column;
      gap: 0.2rem;
    }
  }
</style>
