---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import defaultSocialImage from "../assets/images/al-rahma-conference/shaykh-hammad-facing-crowd.png";
import logo from "../assets/images/logo/myl_logo.png";
import { organization, socialLinks } from "../data/site.js";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  headerTheme?: "default" | "overlay";
  showHeader?: boolean;
  showFooter?: boolean;
  themeColor?: string;
}

const pathname = Astro.url.pathname;
const {
  title = "Muslim Youth League Canada",
  description = "MYL Canada creates spaces for young Muslims to learn, connect, serve and lead through faith-centred events, retreats, sport and scholarship.",
  image = defaultSocialImage,
  headerTheme = pathname === "/" ? "overlay" : "default",
  showHeader = true,
  showFooter = true,
  themeColor = "#153d2b",
} = Astro.props;

const pageTitle = title === organization.name ? title : `${title} | ${organization.shortName}`;
const faviconImage = await getImage({ src: logo, width: 64, height: 64, format: "png" });
const socialImage = await getImage({
  src: image,
  width: 1200,
  height: 630,
  format: "jpeg",
  quality: 84,
});
const canonicalUrl = Astro.site ? new URL(pathname, Astro.site) : undefined;
const socialImageUrl = Astro.site
  ? new URL(socialImage.src, Astro.site).toString()
  : socialImage.src;
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: organization.name,
  alternateName: organization.shortName,
  email: organization.email,
  telephone: organization.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: "2505 Dixie Rd",
    addressLocality: "Mississauga",
    addressRegion: "ON",
    postalCode: "L4Y 2A1",
    addressCountry: "CA",
  },
  sameAs: socialLinks.map((social) => social.href),
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={faviconImage.src} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content={themeColor} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={organization.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
  </head>
  <body data-path={pathname}>
    {showHeader && <Header theme={headerTheme} />}
    <slot />
    {showFooter && <Footer />}
  </body>
</html>
